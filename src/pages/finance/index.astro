---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import PostGrid from '../../components/PostGrid.astro';

const posts = await getCollection('posts', ({ data }) =>
  data.pillar === 'finance' && !data.draft
);
posts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function postUrl(post: typeof posts[0]) {
  const [pillar, ...rest] = post.id.split('/');
  return `${base}/${pillar}/${rest.join('/')}/`;
}

const featured = posts[0];
const rest = posts.filter(p => p.id !== featured?.id);
---

<Base title="Finance" description="Markets, money, and the trends driving them.">

  <section class="pillar-hero">
    <div class="container">
      <p class="section-label">Finance</p>
      <h1>Markets, money, and the trends driving them.</h1>
    </div>
  </section>

  {featured && (
    <section class="featured-section container" style="padding-top: 2rem;">
      <a href={postUrl(featured)} class="featured-card" style="text-decoration:none; color:inherit;">
        <div class="featured-image">
          <img src={featured.data.image} alt={featured.data.title} loading="eager" width="1200" height="675" />
        </div>
        <div class="featured-content">
          <p class="featured-label">Latest</p>
          <h2><span>{featured.data.title}</span></h2>
          <p class="featured-excerpt">{featured.data.excerpt}</p>
          <span class="read-more">Read More</span>
        </div>
      </a>
    </section>
  )}

  <section class="container" style="padding-top: 2rem;">
    <PostGrid posts={rest} />
  </section>

</Base>
