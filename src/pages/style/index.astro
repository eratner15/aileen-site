---
import Base from '../../layouts/Base.astro';

const posts = [
  {
    title: 'Quiet Luxury Brands Worth Knowing in 2026',
    slug: '/style/quiet-luxury-brands/',
    excerpt: 'The brands that whisper instead of shout. Timeless pieces that earn their place in your closet.',
    date: 'February 2026',
    image: 'https://images.unsplash.com/photo-1490481651871-ab68de25d43d?w=600&h=400&fit=crop',
  },
  {
    title: 'Carolyn Bessette-Kennedy Style: The Definitive Guide',
    slug: '/style/carolyn-bessette-kennedy-style/',
    excerpt: 'Her wardrobe was deceptively simple. A handful of pieces, always in proportion, always unhurried.',
    date: 'January 2026',
    image: 'https://images.unsplash.com/photo-1551232864-3f0890e580d9?w=600&h=400&fit=crop',
  },
  {
    title: 'The Elegant Dinner Outfit: What to Wear When It Matters',
    slug: '/style/elegant-dinner-outfit/',
    excerpt: 'Not overdressed. Not underdressed. The kind of outfit that makes you feel like the best version of yourself at the table.',
    date: 'December 2025',
    image: 'https://images.unsplash.com/photo-1539109136881-3be0616acf4b?w=600&h=400&fit=crop',
  },
  {
    title: 'Summer Capsule Wardrobe: Only the Pieces That Earn Their Place',
    slug: '/style/summer-capsule-wardrobe/',
    excerpt: 'Fewer pieces, better choices. A refined summer wardrobe built on what actually works — not what\'s trending for a week.',
    date: 'November 2025',
    image: 'https://images.unsplash.com/photo-1469334031218-e382a71b716b?w=600&h=400&fit=crop',
  },
];
---

<Base title="Style" description="Timeless style, quiet luxury, and wardrobe guides. The kind of pieces that earn their place in your closet.">

  <section class="pillar-hero">
    <div class="container">
      <p class="section-label">Style</p>
      <h1>The pieces worth keeping.</h1>
      <p class="pillar-description">
        Timeless wardrobe guides, quiet luxury finds, and style that doesn't need to try.
        Less trend-chasing, more investing in what lasts.
      </p>
    </div>
  </section>

  <section class="container" style="padding-top: 3rem;">
    <div class="post-grid">
      {posts.map(post => (
        <article class="post-card">
          <a href={post.slug} style="text-decoration:none; color:inherit;">
            <div class="post-card-image">
              <img src={post.image} alt={post.title} loading="lazy" />
              <span class="pillar-badge">Style</span>
            </div>
            <div class="post-card-body">
              <h3><span>{post.title}</span></h3>
              <p class="post-card-excerpt">{post.excerpt}</p>
              <p class="post-card-meta">{post.date}</p>
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>

</Base>
