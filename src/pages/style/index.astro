---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import NewsletterCTA from '../../components/NewsletterCTA.astro';

const posts = await getCollection('posts', ({ data }) =>
  !data.draft && data.pillar === 'style'
);
posts.sort((a, b) => {
  if (a.data.cornerstone && !b.data.cornerstone) return -1;
  if (!a.data.cornerstone && b.data.cornerstone) return 1;
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const featured = posts.find(p => p.data.featured || p.data.cornerstone) || posts[0];
const cornerstones = posts.filter(p => p.data.cornerstone);
const rest = posts.filter(p => p.id !== featured?.id);

function postUrl(post: typeof posts[0]) {
  const [pillar, ...r] = post.id.split('/');
  return `${base}/${pillar}/${r.join('/')}/`;
}
---

<Base title="Style" description="What to wear, what to keep, and what to skip. Style guides for women who value quality over quantity, elegance over flash, and pieces that work for years — not just one season.">

  <section class="pillar-hero">
    <div class="container">
      <p class="section-label">Style</p>
      <h1>Timeless, not trendy.</h1>
      <p class="pillar-description">
        What to wear, what to keep, and what to skip. Style guides for women who value quality over quantity,
        elegance over flash, and pieces that work for years — not just one season.
      </p>
    </div>
  </section>

  <!-- Featured / Hero Post -->
  {featured && (
    <section class="container" style="padding: 3rem 0 1rem;">
      <a href={postUrl(featured)} class="cluster-feature" style="text-decoration:none; color:inherit; display:block;">
        <div class="cluster-feature-image">
          <img src={featured.data.image} alt={featured.data.imageAlt} loading="eager" width="800" height="500" />
        </div>
        <div class="cluster-feature-body">
          <h3>{featured.data.title}</h3>
          <p>{featured.data.excerpt}</p>
          <span class="read-more">Read Guide</span>
        </div>
      </a>
    </section>
  )}

  <!-- Cornerstones -->
  {cornerstones.length > 1 && (
    <section class="container" style="padding: 2rem 0;">
      <div class="section-header section-header--editorial">
        <div class="section-rule"></div>
        <p class="section-label">Essential Guides</p>
      </div>
      <div class="post-grid post-grid--4">
        {cornerstones.filter(p => p.id !== featured?.id).slice(0, 4).map(post => (
          <PostCard
            title={post.data.title}
            href={postUrl(post)}
            pillar={post.data.pillar}
            excerpt={post.data.excerpt}
            date={post.data.date}
            image={post.data.image.replace('1200', '400').replace('675', '280')}
          />
        ))}
      </div>
    </section>
  )}

  <!-- All style guides -->
  <section class="container" style="padding: 2rem 0;">
    <div class="section-header section-header--editorial">
      <div class="section-rule"></div>
      <p class="section-label">All Style Guides</p>
    </div>
    <div class="post-grid">
      {rest.map(post => (
        <PostCard
          title={post.data.title}
          href={postUrl(post)}
          pillar={post.data.pillar}
          excerpt={post.data.excerpt}
          date={post.data.date}
          image={post.data.image.replace('1200', '600').replace('675', '400')}
        />
      ))}
    </div>
    {rest.length === 0 && (
      <div class="empty-state"><p>More style guides coming soon.</p></div>
    )}
  </section>

  <!-- Newsletter -->
  <section class="container" style="padding: 1rem 0 2rem;">
    <NewsletterCTA variant="inline" />
  </section>

</Base>
