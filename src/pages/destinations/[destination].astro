---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import NewsletterCTA from '../../components/NewsletterCTA.astro';
import destinations from '../../data/destinations.json';

export function getStaticPaths() {
  return destinations.map(d => ({ params: { destination: d.slug } }));
}

const { destination } = Astro.params;
const meta = destinations.find(d => d.slug === destination) || { slug: destination, label: destination!, description: '', tagline: '', image: '', thumbnail: '', region: '' };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const allPosts = await getCollection('posts', ({ data }) =>
  !data.draft && data.destinations?.includes(destination!)
);
allPosts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const restaurants = allPosts.filter(p => p.data.contentType === 'restaurant-guide');
const hotels = allPosts.filter(p => p.data.contentType === 'hotel-review');
const travel = allPosts.filter(p => p.data.contentType === 'travel-guide');
const style = allPosts.filter(p => p.data.contentType === 'style-guide');
const other = allPosts.filter(p => !['restaurant-guide', 'hotel-review', 'travel-guide', 'style-guide'].includes(p.data.contentType || ''));

// Featured guide for this destination
const featuredGuide = allPosts.find(p => p.data.cornerstone || p.data.featured) || allPosts[0];

function postUrl(post: typeof allPosts[0]) {
  const [pillar, ...rest] = post.id.split('/');
  return `${base}/${pillar}/${rest.join('/')}/`;
}

const sections = [
  { label: 'Where to Eat', icon: 'fork-knife', posts: restaurants },
  { label: 'Where to Stay', icon: 'bed', posts: hotels },
  { label: 'Travel Guides', icon: 'map', posts: travel },
  { label: 'What to Wear', icon: 'hanger', posts: style },
  { label: 'More Guides', icon: 'star', posts: other },
].filter(s => s.posts.length > 0);

// Aileen's favorites: posts marked cornerstone or featured in this destination
const favorites = allPosts.filter(p => p.data.cornerstone || p.data.featured).slice(0, 4);

// Related destinations (same region first, then others)
const relatedDests = destinations
  .filter(d => d.slug !== destination)
  .sort((a, b) => {
    if (a.region === meta.region && b.region !== meta.region) return -1;
    if (a.region !== meta.region && b.region === meta.region) return 1;
    return 0;
  })
  .slice(0, 5);
---

<Base title={`${meta.label} Guide`} description={meta.description} ogImage={meta.image}>

  <!-- Destination Hero -->
  <section class="destination-hero" style={`background-image: url(${meta.image})`}>
    <div class="destination-hero-overlay">
      <p class="section-label" style="color: rgba(255,255,255,0.7);">Destination Guide</p>
      <h1>{meta.label}</h1>
      <p class="destination-description">{meta.description}</p>
      <p class="destination-count" style="font-family: var(--font-ui); font-size: 0.65rem; letter-spacing: 0.15em; text-transform: uppercase; color: rgba(255,255,255,0.6); margin-top: 1rem;">
        {allPosts.length} {allPosts.length === 1 ? 'guide' : 'guides'}
      </p>
    </div>
  </section>

  <!-- Featured Guide -->
  {featuredGuide && (
    <section class="container" style="padding: 3rem 0 1rem;">
      <div class="section-header section-header--editorial">
        <div class="section-rule"></div>
        <p class="section-label">Featured Guide</p>
      </div>
      <a href={postUrl(featuredGuide)} class="cluster-feature" style="text-decoration:none; color:inherit; display:block;">
        <div class="cluster-feature-image">
          <img src={featuredGuide.data.image} alt={featuredGuide.data.imageAlt} loading="eager" width="800" height="500" />
        </div>
        <div class="cluster-feature-body">
          <h3>{featuredGuide.data.title}</h3>
          <p>{featuredGuide.data.excerpt}</p>
          <span class="read-more">Read Guide</span>
        </div>
      </a>
    </section>
  )}

  <!-- Sections by type -->
  {sections.map(section => (
    <section class="container destination-section" style="padding: 2rem 0;">
      <div class="section-header section-header--editorial" style="margin-bottom: 1.5rem;">
        <div class="section-rule"></div>
        <p class="section-label">{section.label}</p>
      </div>
      <div class="post-grid">
        {section.posts.map(post => (
          <PostCard
            title={post.data.title}
            href={postUrl(post)}
            pillar={post.data.pillar}
            excerpt={post.data.excerpt}
            date={post.data.date}
            image={post.data.image.replace('1200', '600').replace('675', '400')}
          />
        ))}
      </div>
    </section>
  ))}

  {allPosts.length === 0 && (
    <section class="container" style="padding: 4rem 0;">
      <div class="empty-state">
        <p>Guides for {meta.label} are coming soon.</p>
      </div>
    </section>
  )}

  <!-- Aileen's Favorites -->
  {favorites.length > 0 && (
    <section class="container" style="padding: 2rem 0;">
      <div class="section-header section-header--editorial" style="margin-bottom: 1.5rem;">
        <div class="section-rule"></div>
        <p class="section-label">Aileen's Short List</p>
        <h2>The ones I keep coming back to.</h2>
      </div>
      <div class="post-grid post-grid--4">
        {favorites.map(post => (
          <PostCard
            title={post.data.title}
            href={postUrl(post)}
            pillar={post.data.pillar}
            excerpt={post.data.excerpt}
            date={post.data.date}
            image={post.data.image.replace('1200', '400').replace('675', '280')}
          />
        ))}
      </div>
    </section>
  )}

  <!-- Newsletter CTA -->
  <section class="container" style="padding: 2rem 0;">
    <NewsletterCTA variant="destination" destination={meta.label} />
  </section>

  <!-- Related Destinations -->
  <section class="container" style="padding: 2rem 0 3rem;">
    <div class="section-header section-header--editorial" style="margin-bottom: 1.5rem;">
      <div class="section-rule"></div>
      <p class="section-label">More Destinations</p>
    </div>
    <div class="related-destinations">
      {relatedDests.map(dest => (
        <a href={`${base}/destinations/${dest.slug}/`} class="related-destination-link">
          {dest.label}
        </a>
      ))}
    </div>
  </section>

</Base>
