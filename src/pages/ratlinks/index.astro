---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// RatLinks = posts from the original newsletter archive
const ratlinks = allPosts
  .filter(p => p.data.source === 'ratlinks' || p.data.source === 'substack' || p.data.sourceUrl)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

function postUrl(post: typeof allPosts[0]) {
  const [pillar, ...rest] = post.id.split('/');
  return `${base}/${pillar}/${rest.join('/')}/`;
}
---

<Base title="RatLinks Archive" description="The complete RatLinks newsletter archive. Business, culture, markets, and everything worth knowing.">
  <section class="article-header">
    <h1>RatLinks Archive</h1>
    <p class="article-meta">The complete newsletter archive — {ratlinks.length} editions of business, culture, markets, and everything in between.</p>
  </section>

  <div class="container" style="padding-bottom: 3rem;">
    {ratlinks.length > 0 ? (
      <div class="post-grid">
        {ratlinks.map(post => (
          <PostCard
            title={post.data.title}
            href={postUrl(post)}
            pillar={post.data.pillar}
            excerpt={post.data.excerpt}
            date={post.data.date}
            image={post.data.image.replace('1200', '600').replace('675', '400')}
          />
        ))}
      </div>
    ) : (
      <p style="text-align: center; color: #999;">No archive posts found.</p>
    )}
  </div>
</Base>
