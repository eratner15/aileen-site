---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
allPosts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const featured = allPosts[0];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function postUrl(post: typeof allPosts[0]) {
  const [pillar, ...rest] = post.id.split('/');
  return `${base}/${pillar}/${rest.join('/')}/`;
}

// Content sections
const essays = allPosts
  .filter(p => ['essay', 'article', 'the-edit'].includes(p.data.contentType) && p.id !== featured?.id)
  .slice(0, 6);

const guides = allPosts
  .filter(p => ['guide', 'travel-guide', 'restaurant-guide', 'style-guide', 'hotel-review', 'resource-page', 'playbook'].includes(p.data.contentType))
  .slice(0, 3);

// High-evergreen posts for "From the Archive" section
const archiveHighlights = allPosts
  .filter(p => (p.data.evergreenScore || 0) >= 60 && p.id !== featured?.id)
  .sort((a, b) => (b.data.evergreenScore || 0) - (a.data.evergreenScore || 0))
  .slice(0, 3);

// Fallback if no classification yet — use recent posts
const recentForArchive = archiveHighlights.length > 0 ? archiveHighlights :
  allPosts.filter(p => p.id !== featured?.id && !essays.includes(p)).slice(0, 3);
---

<Base title="EVAN Magazine" description="Business, culture, markets, and everything worth knowing. By Evan Ratner.">

  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <p class="hero-tagline">Essays &middot; Guides &middot; Experiments &middot; Tools</p>
      <h1>EVAN</h1>
      <p class="hero-subtitle">
        A personal media brand by Evan Ratner. Business, culture, markets, and everything worth knowing.
      </p>
    </div>
  </section>

  <!-- Featured Post -->
  {featured && (
    <section class="featured-section container">
      <a href={postUrl(featured)} class="featured-card" style="text-decoration:none; color:inherit;">
        <div class="featured-image">
          <img src={featured.data.image} alt={featured.data.title} loading="eager" width="1200" height="675" />
        </div>
        <div class="featured-content">
          <p class="featured-label">Latest</p>
          <h2><span>{featured.data.title}</span></h2>
          <p class="featured-excerpt">{featured.data.excerpt}</p>
          <span class="read-more">Read More</span>
        </div>
      </a>
    </section>
  )}

  <!-- Essays -->
  {essays.length > 0 && (
    <section class="container" style="padding-bottom: 1rem;">
      <div class="section-header">
        <p class="section-label">Essays</p>
        <h2>Analysis &amp; Opinion</h2>
      </div>
      <div class="post-grid">
        {essays.slice(0, 3).map(post => (
          <PostCard
            title={post.data.title}
            href={postUrl(post)}
            pillar={post.data.pillar}
            excerpt={post.data.excerpt}
            date={post.data.date}
            image={post.data.image.replace('1200', '600').replace('675', '400')}
          />
        ))}
      </div>
      <div style="text-align: center; margin-top: 1.5rem;">
        <a href={`${base}/essays/`} class="read-more" style="text-decoration: none;">All Essays &rarr;</a>
      </div>
    </section>
  )}

  <!-- Guides -->
  {guides.length > 0 && (
    <section class="container" style="padding-bottom: 1rem;">
      <div class="section-header">
        <p class="section-label">Guides</p>
        <h2>In-Depth Resources</h2>
      </div>
      <div class="post-grid">
        {guides.map(post => (
          <PostCard
            title={post.data.title}
            href={postUrl(post)}
            pillar={post.data.pillar}
            excerpt={post.data.excerpt}
            date={post.data.date}
            image={post.data.image.replace('1200', '600').replace('675', '400')}
          />
        ))}
      </div>
      <div style="text-align: center; margin-top: 1.5rem;">
        <a href={`${base}/guides/`} class="read-more" style="text-decoration: none;">All Guides &rarr;</a>
      </div>
    </section>
  )}

  <!-- From the Archive -->
  {recentForArchive.length > 0 && (
    <section class="container" style="padding-bottom: 1rem;">
      <div class="section-header">
        <p class="section-label">From the Archive</p>
        <h2>Worth Revisiting</h2>
      </div>
      <div class="post-grid">
        {recentForArchive.map(post => (
          <PostCard
            title={post.data.title}
            href={postUrl(post)}
            pillar={post.data.pillar}
            excerpt={post.data.excerpt}
            date={post.data.date}
            image={post.data.image.replace('1200', '600').replace('675', '400')}
          />
        ))}
      </div>
      <div style="text-align: center; margin-top: 1.5rem;">
        <a href={`${base}/ratlinks/`} class="read-more" style="text-decoration: none;">Full Archive &rarr;</a>
      </div>
    </section>
  )}

  <!-- Newsletter CTA inline -->
  <section class="container" style="padding: 3rem 0; text-align: center;">
    <p class="section-label" style="color: #999;">The EVAN Edit</p>
    <h2 style="margin-bottom: 0.5rem;">Get the newsletter.</h2>
    <p style="color: #666; margin-bottom: 1.5rem;">Business, culture, and everything worth knowing. Weekly.</p>
    <a href={`${base}/subscribe/`} class="read-more" style="text-decoration: none; font-size: 1.1rem;">Subscribe &rarr;</a>
  </section>

</Base>
