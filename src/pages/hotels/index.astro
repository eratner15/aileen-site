---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostGrid from '../../components/PostGrid.astro';

const posts = await getCollection('posts', ({ data }) =>
  !data.draft && (data.contentType === 'hotel-review' || data.targetKeyword?.toLowerCase().includes('hotel') || data.targetKeyword?.toLowerCase().includes('where to stay'))
);
// Cornerstones first, then by date
posts.sort((a, b) => {
  if (a.data.cornerstone && !b.data.cornerstone) return -1;
  if (!a.data.cornerstone && b.data.cornerstone) return 1;
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});
---

<Base title="Hotels" description="Where to stay guides and hotel reviews for people who appreciate the details. Honest reviews of the properties worth rebooking.">

  <section class="pillar-hero">
    <div class="container">
      <p class="section-label">Hotels</p>
      <h1>Worth rebooking.</h1>
      <p class="pillar-description">
        Where to stay when it matters. Hotel reviews and city-by-city guides for the properties that deliver
        on their promise — the rooms, the service, the location. Not every luxury hotel is worth the rate. These are.
      </p>
    </div>
  </section>

  <section class="container" style="padding-top: 3rem;">
    <PostGrid posts={posts} />
  </section>

</Base>
