---
import Base from '../layouts/Base.astro';
---

<Base title="Subscribe" description="Subscribe to The EVAN Edit — business, culture, markets, and everything worth knowing. Weekly.">

  <section class="article-header">
    <h1>The EVAN Edit</h1>
    <p class="article-meta">Business, culture, markets, and everything worth knowing.</p>
  </section>

  <div class="article-body">
    <p>A weekly newsletter with sharp takes on business, culture, markets, and the things worth paying attention to. No fluff, no filler.</p>

    <div class="subscribe-form-section" style="margin: 2rem 0;">
      <iframe src="https://ratlinks.substack.com/embed" width="100%" height="150" style="border:none; background:white;" frameborder="0" scrolling="no"></iframe>
    </div>

    <p style="margin-top: 2rem; color: #666;">Or subscribe directly at <a href="https://ratlinks.substack.com" target="_blank" rel="noopener">ratlinks.substack.com</a>.</p>
  </div>

</Base>
