---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostGrid from '../../components/PostGrid.astro';

const posts = await getCollection('posts', ({ data }) =>
  !data.draft && (data.contentType === 'the-edit' || data.contentType === 'style-guide')
);
posts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<Base title="The Edit" description="Curated product picks, shopping roundups, and style edits. The pieces, places, and things worth knowing about right now.">

  <section class="pillar-hero">
    <div class="container">
      <p class="section-label">The Edit</p>
      <h1>Worth knowing about right now.</h1>
      <p class="pillar-description">
        Curated shopping edits, product picks, and style roundups. Not everything — just the things that have earned a place on the list.
        Updated regularly with what's actually good.
      </p>
    </div>
  </section>

  <section class="container" style="padding-top: 3rem;">
    <PostGrid posts={posts} />
  </section>

</Base>
