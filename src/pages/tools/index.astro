---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const tools = allPosts
  .filter(p => ['tool-page', 'affiliate-stack'].includes(p.data.contentType))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

function postUrl(post: typeof allPosts[0]) {
  const [pillar, ...rest] = post.id.split('/');
  return `${base}/${pillar}/${rest.join('/')}/`;
}
---

<Base title="Tools" description="Tools, stacks, and resources worth using. By Evan Ratner.">
  <section class="article-header">
    <h1>Tools</h1>
    <p class="article-meta">Tools, stacks, and resources I actually use and recommend.</p>
  </section>

  <div class="container" style="padding-bottom: 3rem;">
    {tools.length > 0 ? (
      <div class="post-grid">
        {tools.map(post => (
          <PostCard
            title={post.data.title}
            href={postUrl(post)}
            pillar={post.data.pillar}
            excerpt={post.data.excerpt}
            date={post.data.date}
            image={post.data.image.replace('1200', '600').replace('675', '400')}
          />
        ))}
      </div>
    ) : (
      <p style="text-align: center; color: #999;">Tool and resource pages coming soon. These will feature curated recommendations with real context.</p>
    )}
  </div>
</Base>
