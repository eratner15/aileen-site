---
import Base from '../../layouts/Base.astro';

const posts = [
  {
    title: 'Sourdough Bread Recipe (The One I Actually Use)',
    slug: '/recipes/sourdough-bread/',
    excerpt: 'After dozens of failed loaves and more flour than I care to admit, this is the sourdough recipe I go back to every single week.',
    date: 'January 2026',
    image: 'https://images.unsplash.com/photo-1509440159596-0249088772ff?w=600&h=400&fit=crop',
  },
  {
    title: 'Easy Roast Chicken (The Sunday Recipe)',
    slug: '/recipes/easy-roast-chicken/',
    excerpt: 'The kind of recipe that makes your kitchen smell like home. Simple, reliable, and the one I make almost every Sunday.',
    date: 'December 2025',
    image: 'https://images.unsplash.com/photo-1598103442097-8b74394b95c6?w=600&h=400&fit=crop',
  },
  {
    title: 'Elegant Dinner Party Recipes Worth the Effort',
    slug: '/recipes/dinner-party-recipes/',
    excerpt: 'When the table matters and the food needs to deliver. Recipes that impress without requiring culinary school.',
    date: 'November 2025',
    image: 'https://images.unsplash.com/photo-1547573854-74d2a71d0826?w=600&h=400&fit=crop',
  },
  {
    title: 'Easy Meatloaf Recipe (Better Than You Think)',
    slug: '/recipes/easy-meatloaf/',
    excerpt: 'Meatloaf doesn\'t need to be boring. This version is the one that converted even the skeptics at my table.',
    date: 'October 2025',
    image: 'https://images.unsplash.com/photo-1544025162-d76694265947?w=600&h=400&fit=crop',
  },
];
---

<Base title="Recipes" description="Simple, elegant recipes that feel like home. The kind you'll actually make again.">

  <section class="pillar-hero">
    <div class="container">
      <p class="section-label">Recipes</p>
      <h1>Food that feels like home.</h1>
      <p class="pillar-description">
        Simple, honest recipes that earn a place in your weekly rotation.
        The kind of food you make for the people you love — no fuss, no pretense.
      </p>
    </div>
  </section>

  <section class="container" style="padding-top: 3rem;">
    <div class="post-grid">
      {posts.map(post => (
        <article class="post-card">
          <a href={post.slug} style="text-decoration:none; color:inherit;">
            <div class="post-card-image">
              <img src={post.image} alt={post.title} loading="lazy" />
              <span class="pillar-badge">Recipes</span>
            </div>
            <div class="post-card-body">
              <h3><span>{post.title}</span></h3>
              <p class="post-card-excerpt">{post.excerpt}</p>
              <p class="post-card-meta">{post.date}</p>
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>

</Base>
