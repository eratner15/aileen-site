---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const guides = allPosts
  .filter(p => ['guide', 'travel-guide', 'restaurant-guide', 'style-guide', 'hotel-review', 'destination-hub', 'resource-page', 'playbook'].includes(p.data.contentType))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

function postUrl(post: typeof allPosts[0]) {
  const [pillar, ...rest] = post.id.split('/');
  return `${base}/${pillar}/${rest.join('/')}/`;
}
---

<Base title="Guides" description="In-depth guides on travel, restaurants, tools, and more. By Evan Ratner.">
  <section class="article-header">
    <h1>Guides</h1>
    <p class="article-meta">In-depth guides, resource pages, and actionable playbooks.</p>
  </section>

  <div class="container" style="padding-bottom: 3rem;">
    {guides.length > 0 ? (
      <div class="post-grid">
        {guides.map(post => (
          <PostCard
            title={post.data.title}
            href={postUrl(post)}
            pillar={post.data.pillar}
            excerpt={post.data.excerpt}
            date={post.data.date}
            image={post.data.image.replace('1200', '600').replace('675', '400')}
          />
        ))}
      </div>
    ) : (
      <p style="text-align: center; color: #999;">No guides published yet. Guides will appear here as archive essays are converted into actionable resources.</p>
    )}
  </div>
</Base>
