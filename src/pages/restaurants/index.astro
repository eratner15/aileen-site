---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import NewsletterCTA from '../../components/NewsletterCTA.astro';

const posts = await getCollection('posts', ({ data }) =>
  !data.draft && (data.contentType === 'restaurant-guide' || data.targetKeyword?.toLowerCase().includes('restaurant'))
);
posts.sort((a, b) => {
  if (a.data.cornerstone && !b.data.cornerstone) return -1;
  if (!a.data.cornerstone && b.data.cornerstone) return 1;
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const featured = posts.find(p => p.data.featured || p.data.cornerstone) || posts[0];
const cornerstones = posts.filter(p => p.data.cornerstone);
const rest = posts.filter(p => p.id !== featured?.id);

// Group by destination
const destGroups: Record<string, typeof posts> = {};
for (const p of rest) {
  for (const d of p.data.destinations || ['other']) {
    if (!destGroups[d]) destGroups[d] = [];
    destGroups[d].push(p);
  }
}

function postUrl(post: typeof posts[0]) {
  const [pillar, ...r] = post.id.split('/');
  return `${base}/${pillar}/${r.join('/')}/`;
}
---

<Base title="Restaurants" description="Restaurant guides for the places worth the reservation. From Miami to Palm Beach, Boston to NYC — only the spots we go back to.">

  <section class="pillar-hero">
    <div class="container">
      <p class="section-label">Restaurants</p>
      <h1>Worth the reservation.</h1>
      <p class="pillar-description">
        The restaurants I go back to — not because someone told me to try them, but because the food is genuinely good,
        the rooms are beautiful, and the experience delivers every time. City-by-city guides for people who care about where they eat.
      </p>
    </div>
  </section>

  <!-- Featured / Hero Post -->
  {featured && (
    <section class="container" style="padding: 3rem 0 1rem;">
      <a href={postUrl(featured)} class="cluster-feature" style="text-decoration:none; color:inherit; display:block;">
        <div class="cluster-feature-image">
          <img src={featured.data.image} alt={featured.data.imageAlt} loading="eager" width="800" height="500" />
        </div>
        <div class="cluster-feature-body">
          <h3>{featured.data.title}</h3>
          <p>{featured.data.excerpt}</p>
          <span class="read-more">Read Guide</span>
        </div>
      </a>
    </section>
  )}

  <!-- Cornerstones -->
  {cornerstones.length > 1 && (
    <section class="container" style="padding: 2rem 0;">
      <div class="section-header section-header--editorial">
        <div class="section-rule"></div>
        <p class="section-label">Essential Guides</p>
      </div>
      <div class="post-grid post-grid--4">
        {cornerstones.filter(p => p.id !== featured?.id).slice(0, 4).map(post => (
          <PostCard
            title={post.data.title}
            href={postUrl(post)}
            pillar={post.data.pillar}
            excerpt={post.data.excerpt}
            date={post.data.date}
            image={post.data.image.replace('1200', '400').replace('675', '280')}
          />
        ))}
      </div>
    </section>
  )}

  <!-- All restaurant guides -->
  <section class="container" style="padding: 2rem 0;">
    <div class="section-header section-header--editorial">
      <div class="section-rule"></div>
      <p class="section-label">All Restaurant Guides</p>
    </div>
    <div class="post-grid">
      {rest.map(post => (
        <PostCard
          title={post.data.title}
          href={postUrl(post)}
          pillar={post.data.pillar}
          excerpt={post.data.excerpt}
          date={post.data.date}
          image={post.data.image.replace('1200', '600').replace('675', '400')}
        />
      ))}
    </div>
    {rest.length === 0 && (
      <div class="empty-state"><p>More restaurant guides coming soon.</p></div>
    )}
  </section>

  <!-- Newsletter -->
  <section class="container" style="padding: 1rem 0 2rem;">
    <NewsletterCTA variant="inline" />
  </section>

</Base>
