---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostGrid from '../../components/PostGrid.astro';

const posts = await getCollection('posts', ({ data }) =>
  !data.draft && (data.contentType === 'restaurant-guide' || data.targetKeyword?.toLowerCase().includes('restaurant'))
);
// Cornerstones first, then by date
posts.sort((a, b) => {
  if (a.data.cornerstone && !b.data.cornerstone) return -1;
  if (!a.data.cornerstone && b.data.cornerstone) return 1;
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});
---

<Base title="Restaurants" description="Restaurant guides for the places worth the reservation. From Miami to Palm Beach, Boston to NYC — only the spots we go back to.">

  <section class="pillar-hero">
    <div class="container">
      <p class="section-label">Restaurants</p>
      <h1>Worth the reservation.</h1>
      <p class="pillar-description">
        The restaurants I go back to — not because someone told me to try them, but because the food is genuinely good,
        the rooms are beautiful, and the experience delivers every time. City-by-city guides for people who care about where they eat.
      </p>
    </div>
  </section>

  <section class="container" style="padding-top: 3rem;">
    <PostGrid posts={posts} />
  </section>

</Base>
