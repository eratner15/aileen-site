---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AdminNav from '../../components/AdminNav.astro';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Content stats
const totalPosts = allPosts.length;
const totalWords = allPosts.reduce((sum, p) => sum + (p.body?.split(/\s+/).length || 0), 0);
const avgWords = totalPosts > 0 ? Math.round(totalWords / totalPosts) : 0;
const withFaq = allPosts.filter(p => p.data.faq && p.data.faq.length > 0).length;
const withProducts = allPosts.filter(p => p.data.products.length > 0).length;

// Pillar distribution
const pillars: Record<string, number> = {};
for (const p of allPosts) {
  pillars[p.data.pillar] = (pillars[p.data.pillar] || 0) + 1;
}

// Destination coverage
const destCounts: Record<string, number> = {};
for (const p of allPosts) {
  for (const d of p.data.destinations || []) {
    destCounts[d] = (destCounts[d] || 0) + 1;
  }
}
---

<Base title="Performance | Admin" noindex={true} isAdmin={true}>
  <div class="admin-layout">
    <h1>Performance Dashboard</h1>
    <p class="admin-subtitle">Data-driven decisions. Refresh winners, expand what works.</p>

    <AdminNav active="performance" />

    <!-- GA4 connection check -->
    <div class="admin-card" id="ga4-status-card" style="border-left: 3px solid var(--color-warning); margin-bottom: 2rem;">
      <h3>Live Traffic Data</h3>
      <p style="font-family: var(--font-ui); font-size: 0.85rem; color: var(--color-text-secondary);">
        Google Analytics is <strong>not yet connected</strong>. Connect GA4 in
        <a href={`${base}/admin/settings/`} style="border-bottom: 1px solid var(--color-border);">Settings</a>
        to see live traffic, top pages, and performance trends.
      </p>
      <p style="font-family: var(--font-ui); font-size: 0.78rem; color: var(--color-text-muted); margin-top: 0.5rem;">
        The data below reflects content inventory only (build-time), not live traffic.
      </p>
    </div>

    <!-- Content inventory stats -->
    <div class="admin-stats-grid">
      <div class="admin-stat">
        <span class="admin-stat-number">{totalPosts}</span>
        <span class="admin-stat-label">Published Posts</span>
      </div>
      <div class="admin-stat">
        <span class="admin-stat-number">{Math.round(totalWords / 1000)}K</span>
        <span class="admin-stat-label">Total Words</span>
      </div>
      <div class="admin-stat">
        <span class="admin-stat-number">{avgWords}</span>
        <span class="admin-stat-label">Avg Words/Post</span>
      </div>
      <div class="admin-stat">
        <span class="admin-stat-number">{withFaq}</span>
        <span class="admin-stat-label">Posts with FAQ</span>
      </div>
      <div class="admin-stat">
        <span class="admin-stat-number">{withProducts}</span>
        <span class="admin-stat-label">Monetized Posts</span>
      </div>
    </div>

    <!-- Mediavine goal tracker -->
    <div class="admin-card">
      <h2>50K Session Goal</h2>
      <p style="font-family: var(--font-ui); font-size: 0.82rem; color: var(--color-text-muted); margin-bottom: 1rem;">
        Mediavine requires 50,000 monthly sessions. Enter your latest GA4 session count to track progress.
      </p>
      <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem;">
        <input type="number" id="session-count" placeholder="Current monthly sessions" style="padding: 0.6rem 0.8rem; font-family: var(--font-ui); font-size: 0.85rem; border: 1px solid var(--color-border); width: 200px;" />
        <button class="admin-btn" id="update-goal-btn">Update</button>
      </div>
      <div style="background: var(--color-bg-alt); height: 20px; overflow: hidden; position: relative;">
        <div id="goal-bar" style="height: 100%; background: var(--color-text); width: 0%; transition: width 0.8s ease;"></div>
      </div>
      <p id="goal-label" style="font-family: var(--font-ui); font-size: 0.72rem; color: var(--color-text-muted); margin-top: 0.5rem;">
        Enter your session count to see progress.
      </p>
    </div>

    <!-- Content by pillar -->
    <div class="admin-card">
      <h2>Content by Pillar</h2>
      <div class="admin-bar-chart">
        {Object.entries(pillars).sort((a,b) => b[1] - a[1]).map(([pillar, count]) => (
          <div class="admin-bar-row">
            <span class="admin-bar-label">{pillar.charAt(0).toUpperCase() + pillar.slice(1)}</span>
            <div class="admin-bar-track">
              <div class="admin-bar-fill" style={`width: ${Math.round(count / totalPosts * 100)}%`}></div>
            </div>
            <span class="admin-bar-count">{count}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Content by destination -->
    <div class="admin-card">
      <h2>Content by Destination</h2>
      <div class="admin-bar-chart">
        {Object.entries(destCounts).sort((a,b) => b[1] - a[1]).map(([dest, count]) => (
          <div class="admin-bar-row">
            <span class="admin-bar-label">{dest.charAt(0).toUpperCase() + dest.slice(1).replace(/-/g, ' ')}</span>
            <div class="admin-bar-track">
              <div class="admin-bar-fill" style={`width: ${Math.round(count / Math.max(...Object.values(destCounts)) * 100)}%`}></div>
            </div>
            <span class="admin-bar-count">{count}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Recommended actions -->
    <div class="admin-card" style="border-left: 3px solid var(--color-text);">
      <h2>Recommended Actions</h2>
      <p style="font-family: var(--font-ui); font-size: 0.82rem; color: var(--color-text-muted); margin-bottom: 1rem;">
        Based on content inventory analysis. Connect GA4 for traffic-based recommendations.
      </p>
      <div class="priority-list">
        {totalPosts < 50 && (
          <div class="priority-item">
            <div class="priority-item-signal">
              <h4>Increase content volume</h4>
              <p>{totalPosts} posts published — aim for 50+ for strong internal linking and destination hub depth.</p>
            </div>
            <div class="priority-item-actions">
              <a href={`${base}/admin/editorial/`} class="admin-btn admin-btn--small" style="text-decoration:none;">Create Content</a>
            </div>
          </div>
        )}
        {Object.values(pillars).some(v => v < 3) && (
          <div class="priority-item">
            <div class="priority-item-signal">
              <h4>Balance pillar coverage</h4>
              <p>Some pillars have fewer than 3 posts. Balance drives better internal linking.</p>
            </div>
            <div class="priority-item-actions">
              <a href={`${base}/admin/opportunities/`} class="admin-btn admin-btn--small" style="text-decoration:none;">See Gaps</a>
            </div>
          </div>
        )}
        {withFaq < totalPosts * 0.5 && (
          <div class="priority-item">
            <div class="priority-item-signal">
              <h4>Add FAQ sections</h4>
              <p>Only {withFaq}/{totalPosts} posts have FAQ. FAQs improve SEO with featured snippet potential.</p>
            </div>
            <div class="priority-item-actions">
              <a href={`${base}/admin/seo/`} class="admin-btn admin-btn--small" style="text-decoration:none;">SEO Console</a>
            </div>
          </div>
        )}
      </div>
    </div>

    <!-- Growth engine snapshots (from API) -->
    <div class="admin-card" id="snapshots-card">
      <h2>Weekly Snapshots</h2>
      <p style="font-family: var(--font-ui); font-size: 0.82rem; color: var(--color-text-muted); margin-bottom: 1rem;">
        Historical performance data from the growth engine. <span style="font-style: italic;">Requires growth engine API.</span>
      </p>
      <div id="snapshots-content" style="font-family: var(--font-ui); font-size: 0.82rem; color: var(--color-text-muted);">Loading...</div>
    </div>

    <p style="font-family: var(--font-ui); font-size: 0.72rem; color: var(--color-text-muted); margin-top: 2rem; border-top: 1px solid var(--color-border-light); padding-top: 1rem;">
      Data source: Content inventory (build-time). Traffic data requires GA4 connection.
      Snapshot data requires growth engine API (aileen serve).
    </p>
  </div>

  <script>
    const API_URL = localStorage.getItem('aileen_api_url') || 'http://localhost:3001';

    function updateGoal() {
      const input = document.getElementById('session-count') as HTMLInputElement;
      const bar = document.getElementById('goal-bar');
      const label = document.getElementById('goal-label');
      const sessions = parseInt(input?.value || '0');
      if (sessions > 0 && bar && label) {
        const pct = Math.min(100, Math.round((sessions / 50000) * 100));
        bar.style.width = `${pct}%`;
        label.textContent = `${sessions.toLocaleString()} / 50,000 sessions (${pct}%)`;
        localStorage.setItem('aileen_sessions', String(sessions));
      }
    }

    document.getElementById('update-goal-btn')?.addEventListener('click', updateGoal);

    // Restore saved session count
    const saved = localStorage.getItem('aileen_sessions');
    if (saved) {
      const input = document.getElementById('session-count') as HTMLInputElement;
      if (input) input.value = saved;
      updateGoal();
    }

    // Load snapshots from API
    async function loadSnapshots() {
      const el = document.getElementById('snapshots-content');
      try {
        const res = await fetch(`${API_URL}/api/status`, { signal: AbortSignal.timeout(3000) });
        const data = await res.json();
        if (el) {
          el.innerHTML = `
            <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem;">
              <div><strong>${data.pipeline?.planned || 0}</strong><br/>Planned</div>
              <div><strong>${data.pipeline?.drafted || 0}</strong><br/>Drafted</div>
              <div><strong>${data.pins?.total || 0}</strong><br/>Pins</div>
              <div><strong>${data.sessions || 0}</strong><br/>Last Sessions</div>
            </div>
          `;
        }
      } catch {
        if (el) el.textContent = 'Growth engine API not available. Run: aileen serve';
      }
    }

    loadSnapshots();
  </script>
</Base>
