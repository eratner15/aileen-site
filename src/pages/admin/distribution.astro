---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Distribution stats
const withPins = allPosts.filter(p => p.data.pinsGenerated > 0);
const inNewsletter = allPosts.filter(p => p.data.newsletterIncluded);
const withTags = allPosts.filter(p => p.data.tags.length > 3); // proxy for social copy readiness
const totalPins = allPosts.reduce((s, p) => s + p.data.pinsGenerated, 0);

const pctPins = allPosts.length > 0 ? Math.round((withPins.length / allPosts.length) * 100) : 0;
const pctNewsletter = allPosts.length > 0 ? Math.round((inNewsletter.length / allPosts.length) * 100) : 0;
const pctSocial = allPosts.length > 0 ? Math.round((withTags.length / allPosts.length) * 100) : 0;

// Pinterest: posts without pins sorted by evergreenScore
const noPins = allPosts
  .filter(p => p.data.pinsGenerated === 0)
  .sort((a, b) => b.data.evergreenScore - a.data.evergreenScore);

// Newsletter: high evergreen not included
const notInNewsletter = allPosts
  .filter(p => !p.data.newsletterIncluded && p.data.evergreenScore > 30)
  .sort((a, b) => b.data.evergreenScore - a.data.evergreenScore);

// Full distribution table
const distTable = [...allPosts].sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<Base title="Distribution Engine | Admin" noindex={true}>
  <div class="admin-wrap">
    <div class="admin-header">
      <h1>Distribution Engine</h1>
    </div>

    <nav class="admin-nav">
      <a href={`${base}/admin/`}>Command Center</a>
      <a href={`${base}/admin/content/`}>Content</a>
      <a href={`${base}/admin/archive/`}>Evergreen</a>
      <a href={`${base}/admin/seo/`}>SEO</a>
      <a href={`${base}/admin/distribution/`} class="active">Distribution</a>
      <a href={`${base}/admin/revenue/`}>Revenue</a>
      <a href={`${base}/admin/performance/`}>Performance</a>
      <a href={`${base}/admin/ai-assist/`}>AI Assist</a>
      <a href={`${base}/admin/settings/`}>Settings</a>
    </nav>

    <!-- Distribution Completeness -->
    <section class="admin-section">
      <h2>Distribution Completeness</h2>
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-number">{totalPins}</div>
          <div class="stat-label">Total Pins</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">{pctPins}%</div>
          <div class="stat-label">With Pins</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">{pctNewsletter}%</div>
          <div class="stat-label">In Newsletter</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">{pctSocial}%</div>
          <div class="stat-label">Social Ready</div>
        </div>
      </div>
      <div class="bar-chart">
        <div class="bar-row">
          <span class="bar-label">Pinterest</span>
          <div class="bar-track"><div class="bar-fill" style={`width: ${pctPins}%`}></div></div>
          <span class="bar-count">{withPins.length}/{allPosts.length}</span>
        </div>
        <div class="bar-row">
          <span class="bar-label">Newsletter</span>
          <div class="bar-track"><div class="bar-fill" style={`width: ${pctNewsletter}%`}></div></div>
          <span class="bar-count">{inNewsletter.length}/{allPosts.length}</span>
        </div>
        <div class="bar-row">
          <span class="bar-label">Social</span>
          <div class="bar-track"><div class="bar-fill" style={`width: ${pctSocial}%`}></div></div>
          <span class="bar-count">{withTags.length}/{allPosts.length}</span>
        </div>
      </div>
    </section>

    <!-- Pinterest Section -->
    <section class="admin-section">
      <h2>Pinterest: Posts Without Pins ({noPins.length})</h2>
      {noPins.length > 0 ? (
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Title</th>
                <th>Evergreen Score</th>
                <th>Pillar</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              {noPins.slice(0, 25).map(p => (
                <tr>
                  <td>{p.data.title}</td>
                  <td class="score">{p.data.evergreenScore}</td>
                  <td>{p.data.pillar}</td>
                  <td>
                    <button class="btn btn-sm api-action" data-endpoint="/api/pins" data-slug={p.id}>Generate Pins</button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="empty-state">All posts have pins generated.</p>
      )}
      <div class="result-panel" style="display:none;"></div>
    </section>

    <!-- Newsletter Section -->
    <section class="admin-section">
      <h2>Newsletter: Not Included ({notInNewsletter.length})</h2>
      {notInNewsletter.length > 0 ? (
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Title</th>
                <th>Evergreen Score</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              {notInNewsletter.slice(0, 20).map(p => (
                <tr>
                  <td>{p.data.title}</td>
                  <td class="score">{p.data.evergreenScore}</td>
                  <td>
                    <button class="btn btn-sm api-action" data-endpoint="/api/queue-newsletter" data-slug={p.id}>Queue for Newsletter</button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="empty-state">All high-value posts included in newsletter.</p>
      )}
      <div class="result-panel" style="display:none;"></div>
    </section>

    <!-- Social Section -->
    <section class="admin-section">
      <h2>Social Distribution Overview</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Title</th>
              <th>Date</th>
              <th>Pins</th>
              <th>Newsletter</th>
              <th>Tags</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            {distTable.slice(0, 30).map(p => {
              const hasPins = p.data.pinsGenerated > 0;
              const hasNL = p.data.newsletterIncluded;
              const hasTags = p.data.tags.length > 3;
              const channels = [hasPins, hasNL, hasTags];
              const complete = channels.every(Boolean);
              const partial = channels.some(Boolean);
              return (
                <tr>
                  <td>{p.data.title}</td>
                  <td>{p.data.date}</td>
                  <td class={hasPins ? 'check-pass' : 'check-fail'}>{hasPins ? `${p.data.pinsGenerated}` : 'None'}</td>
                  <td class={hasNL ? 'check-pass' : 'check-fail'}>{hasNL ? 'Yes' : 'No'}</td>
                  <td>{p.data.tags.length}</td>
                  <td><span class={`dist-status ${complete ? 'complete' : partial ? 'partial' : 'none'}`}>{complete ? 'Complete' : partial ? 'Partial' : 'Not Started'}</span></td>
                </tr>
              );
            })}
          </tbody>
        </table>
        {distTable.length > 30 && <p class="table-more">Showing 30 of {distTable.length}</p>}
      </div>
    </section>

    <!-- Bulk Actions -->
    <section class="admin-section">
      <h2>Bulk Actions</h2>
      <div class="quick-actions">
        <button class="btn btn-primary api-action" data-endpoint="/api/pins">Generate Pins (All High-Value)</button>
        <button class="btn btn-primary api-action" data-endpoint="/api/newsletter">Draft Newsletter</button>
        <button class="btn btn-secondary api-action" data-endpoint="/api/social-copy">Generate Social (All)</button>
      </div>
      <div class="result-panel" style="display:none;"></div>
    </section>
  </div>
</Base>

<style>
  .admin-wrap { max-width: 1200px; margin: 0 auto; padding: 2rem 1.5rem; font-family: 'Inter', -apple-system, sans-serif; }
  .admin-header { margin-bottom: 1rem; border-bottom: 3px solid #000; padding-bottom: 1rem; }
  .admin-header h1 { font-family: 'Playfair Display', Georgia, serif; font-size: 2rem; margin: 0; }
  .admin-nav { display: flex; flex-wrap: wrap; gap: 0.25rem; margin-bottom: 2rem; border-bottom: 1px solid #e8e8e8; padding-bottom: 0.75rem; }
  .admin-nav a { padding: 0.4rem 0.75rem; text-decoration: none; color: #666; font-size: 0.85rem; border-radius: 4px; transition: all 0.15s; }
  .admin-nav a:hover { background: #f5f5f5; color: #000; }
  .admin-nav a.active { background: #000; color: #fff; }
  .admin-section { margin-bottom: 2.5rem; }
  .admin-section h2 { font-family: 'Playfair Display', Georgia, serif; font-size: 1.3rem; margin: 0 0 1rem; border-bottom: 1px solid #e8e8e8; padding-bottom: 0.5rem; }
  .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 1rem; margin-bottom: 1.5rem; }
  .stat-card { background: #f5f5f5; padding: 1rem; text-align: center; border: 1px solid #e8e8e8; }
  .stat-number { font-size: 1.75rem; font-weight: 700; color: #000; }
  .stat-label { font-size: 0.7rem; color: #666; text-transform: uppercase; letter-spacing: 0.05em; }
  .bar-chart { margin-top: 1rem; }
  .bar-row { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem; }
  .bar-label { width: 100px; font-size: 0.8rem; font-weight: 600; }
  .bar-track { flex: 1; height: 1.25rem; background: #e8e8e8; }
  .bar-fill { height: 100%; background: #000; transition: width 0.3s; }
  .bar-count { font-size: 0.75rem; color: #666; min-width: 60px; }
  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
  th, td { text-align: left; padding: 0.5rem 0.6rem; border-bottom: 1px solid #e8e8e8; }
  th { font-weight: 600; text-transform: uppercase; font-size: 0.65rem; letter-spacing: 0.05em; color: #666; background: #f5f5f5; }
  .score { font-weight: 700; font-family: monospace; }
  .check-pass { color: #22c55e; font-weight: 600; }
  .check-fail { color: #ef4444; font-weight: 600; }
  .dist-status { font-size: 0.7rem; padding: 0.15rem 0.4rem; font-weight: 600; text-transform: uppercase; }
  .dist-status.complete { background: #f0fdf4; color: #22c55e; }
  .dist-status.partial { background: #fffbeb; color: #f59e0b; }
  .dist-status.none { background: #fef2f2; color: #ef4444; }
  .btn { padding: 0.4rem 0.75rem; border: 1px solid #000; cursor: pointer; font-size: 0.75rem; font-family: inherit; transition: all 0.15s; text-decoration: none; display: inline-block; background: #fff; color: #000; }
  .btn-primary { background: #000; color: #fff; }
  .btn-primary:hover { background: #333; }
  .btn-secondary { background: #fff; color: #000; }
  .btn-sm { padding: 0.2rem 0.4rem; font-size: 0.7rem; }
  .btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .quick-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .result-panel { margin-top: 1rem; padding: 1rem; background: #f5f5f5; border: 1px solid #e8e8e8; font-size: 0.85rem; white-space: pre-wrap; max-height: 400px; overflow-y: auto; font-family: monospace; }
  .empty-state { color: #999; font-style: italic; font-size: 0.9rem; }
  .table-more { font-size: 0.85rem; color: #666; margin-top: 0.5rem; }
</style>

<script>
  const API_BASE = 'http://localhost:3001';

  async function apiCall(endpoint: string, method = 'POST', body?: object) {
    try {
      const res = await fetch(`${API_BASE}${endpoint}`, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: body ? JSON.stringify(body) : undefined,
      });
      if (!res.ok) throw new Error(`API error: ${res.status}`);
      return await res.json();
    } catch (e: any) {
      return { error: true, message: e.message || 'API unavailable. Is the growth engine running on localhost:3001?' };
    }
  }

  document.querySelectorAll('.api-action').forEach(btn => {
    btn.addEventListener('click', async () => {
      const endpoint = (btn as HTMLElement).dataset.endpoint!;
      const slug = (btn as HTMLElement).dataset.slug;
      const origText = btn.textContent;
      btn.textContent = 'Working...';
      (btn as HTMLButtonElement).disabled = true;
      const result = await apiCall(endpoint, 'POST', slug ? { slug } : undefined);
      const panel = btn.closest('.admin-section')?.querySelector('.result-panel');
      if (panel) {
        (panel as HTMLElement).style.display = 'block';
        (panel as HTMLElement).textContent = JSON.stringify(result, null, 2);
      }
      btn.textContent = origText;
      (btn as HTMLButtonElement).disabled = false;
    });
  });
</script>
