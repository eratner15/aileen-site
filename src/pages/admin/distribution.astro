---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AdminNav from '../../components/AdminNav.astro';
import AdminOutput from '../../components/AdminOutput.astro';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Distribution matrix
const matrix = allPosts.map(post => ({
  post,
  newsletter: post.data.distributedNewsletter || post.data.newsletterIncluded,
  pinterest: post.data.distributedPinterest || post.data.pinsGenerated > 0,
  instagram: post.data.distributedInstagram,
  tiktok: post.data.distributedTiktok,
})).sort((a, b) => {
  const aScore = [a.newsletter, a.pinterest, a.instagram, a.tiktok].filter(Boolean).length;
  const bScore = [b.newsletter, b.pinterest, b.instagram, b.tiktok].filter(Boolean).length;
  return aScore - bScore;
});

const undistributed = matrix.filter(m => !m.newsletter && !m.pinterest);
const partiallyDistributed = matrix.filter(m => (m.newsletter || m.pinterest) && (!m.newsletter || !m.pinterest));
const fullyDistributed = matrix.filter(m => m.newsletter && m.pinterest);
---

<Base title="Distribution | Admin" noindex={true} isAdmin={true}>
  <div class="admin-layout">
    <h1>Distribution Engine</h1>
    <p class="admin-subtitle">Generate derivatives. Distribute everywhere. Track coverage.</p>

    <AdminNav active="distribution" />

    <div class="admin-stats-grid">
      <div class="admin-stat">
        <span class="admin-stat-number">{undistributed.length}</span>
        <span class="admin-stat-label">Not Distributed</span>
      </div>
      <div class="admin-stat">
        <span class="admin-stat-number">{partiallyDistributed.length}</span>
        <span class="admin-stat-label">Partial</span>
      </div>
      <div class="admin-stat">
        <span class="admin-stat-number">{fullyDistributed.length}</span>
        <span class="admin-stat-label">Fully Distributed</span>
      </div>
    </div>

    <!-- Batch actions -->
    <div class="admin-actions-bar" style="margin-bottom: 1.5rem;">
      <button class="admin-btn admin-btn--primary" data-api-action="pins">Generate All Missing Pins</button>
      <button class="admin-btn" data-api-action="newsletter">Draft Newsletter</button>
    </div>

    <!-- Distribution matrix -->
    <div class="admin-card">
      <h2>Distribution Matrix</h2>
      <table class="admin-table">
        <thead>
          <tr>
            <th>Post</th>
            <th>Newsletter</th>
            <th>Pinterest</th>
            <th>Instagram</th>
            <th>TikTok</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {matrix.map(m => {
            const check = (done: boolean) => done ? '<span style="color: var(--color-success);">Done</span>' : '<span style="color: var(--color-text-muted);">—</span>';
            return (
              <tr>
                <td>
                  {m.post.data.title}
                  <br/><span style="font-size: 0.65rem; color: var(--color-text-muted);">{m.post.data.pillar}</span>
                </td>
                <td set:html={check(m.newsletter)} />
                <td set:html={check(m.pinterest)} />
                <td set:html={check(m.instagram)} />
                <td set:html={check(m.tiktok)} />
                <td>
                  <div style="display: flex; gap: 0.25rem; flex-wrap: wrap;">
                    {!m.newsletter && <button class="admin-btn admin-btn--small" data-dist-action="newsletter" data-title={m.post.data.title}>Newsletter</button>}
                    {!m.pinterest && <button class="admin-btn admin-btn--small" data-dist-action="social" data-title={m.post.data.title} data-platform="pinterest">Pins</button>}
                    {!m.instagram && <button class="admin-btn admin-btn--small" data-dist-action="instagram" data-title={m.post.data.title}>IG</button>}
                    {!m.tiktok && <button class="admin-btn admin-btn--small" data-dist-action="social" data-title={m.post.data.title} data-platform="tiktok">TikTok</button>}
                    {m.newsletter && m.pinterest && <span style="font-family: var(--font-ui); font-size: 0.65rem; color: var(--color-success);">Distributed</span>}
                  </div>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </div>

  <AdminOutput />

  <script>
    const API_URL = localStorage.getItem('aileen_api_url') || 'http://localhost:3001';
    const output = (window as any).adminOutput;

    // Per-post distribution actions
    document.querySelectorAll('[data-dist-action]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const el = btn as HTMLElement;
        const action = el.dataset.distAction!;
        const title = el.dataset.title || '';
        const platform = el.dataset.platform || '';

        const label = action === 'social' ? platform : action;
        output.show(`${label.charAt(0).toUpperCase() + label.slice(1)}: ${title}`);
        el.classList.add('admin-btn--loading');

        let endpoint = action;
        let body: any = { title };
        if (action === 'social') body.platform = platform;

        try {
          const res = await fetch(`${API_URL}/api/${endpoint}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
          });
          output.setRaw(await res.json());
        } catch {
          output.setError('Could not connect to API. Run: aileen serve');
        }
        el.classList.remove('admin-btn--loading');
      });
    });

    // Batch actions
    document.querySelectorAll('[data-api-action]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const el = btn as HTMLElement;
        const action = el.dataset.apiAction!;
        output.show(`Batch: ${action}`);
        el.classList.add('admin-btn--loading');
        try {
          const res = await fetch(`${API_URL}/api/${action}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({}),
          });
          output.setRaw(await res.json());
        } catch {
          output.setError('Could not connect to API. Run: aileen serve');
        }
        el.classList.remove('admin-btn--loading');
      });
    });
  </script>
</Base>

<style>
  .admin-btn--loading {
    opacity: 0.5;
    pointer-events: none;
  }
</style>
