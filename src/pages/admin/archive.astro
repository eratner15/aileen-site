---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Focus on archive/evergreen content
const archivePosts = allPosts.filter(p => p.data.source !== 'original' || p.data.evergreenScore > 0);

// Best Evergreen Posts (sorted by evergreenScore desc)
const bestEvergreen = [...archivePosts]
  .filter(p => p.data.evergreenScore > 0)
  .sort((a, b) => b.data.evergreenScore - a.data.evergreenScore);

// Refresh Queue
const refreshQueue = archivePosts
  .filter(p => ['high', 'medium'].includes(p.data.refreshPriority))
  .sort((a, b) => {
    const order = { high: 0, medium: 1, low: 2, none: 3 };
    return (order[a.data.refreshPriority] || 3) - (order[b.data.refreshPriority] || 3);
  });

// Derivative Opportunities
const derivativeOpps = archivePosts
  .filter(p => p.data.derivativeScore > 60)
  .sort((a, b) => b.data.derivativeScore - a.data.derivativeScore);

// Monetization Gaps
const monetizationGaps = archivePosts
  .filter(p => p.data.monetizationPotential === 'high' && p.data.products.length === 0);

// Re-share Queue
const reshareQueue = archivePosts
  .filter(p => p.data.evergreenScore > 50 && !p.data.newsletterIncluded)
  .sort((a, b) => b.data.evergreenScore - a.data.evergreenScore);

// Stats
const totalArchive = archivePosts.length;
const classified = archivePosts.filter(p => p.data.status !== 'imported').length;
---

<Base title="Evergreen Engine | Admin" noindex={true}>
  <div class="admin-wrap">
    <div class="admin-header">
      <h1>Evergreen Engine</h1>
    </div>

    <nav class="admin-nav">
      <a href={`${base}/admin/`}>Command Center</a>
      <a href={`${base}/admin/content/`}>Content</a>
      <a href={`${base}/admin/archive/`} class="active">Evergreen</a>
      <a href={`${base}/admin/seo/`}>SEO</a>
      <a href={`${base}/admin/distribution/`}>Distribution</a>
      <a href={`${base}/admin/revenue/`}>Revenue</a>
      <a href={`${base}/admin/performance/`}>Performance</a>
      <a href={`${base}/admin/ai-assist/`}>AI Assist</a>
      <a href={`${base}/admin/settings/`}>Settings</a>
    </nav>

    <!-- Stats -->
    <section class="admin-section">
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-number">{totalArchive}</div>
          <div class="stat-label">Archive Posts</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">{classified}</div>
          <div class="stat-label">Classified</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">{refreshQueue.length}</div>
          <div class="stat-label">Needs Refresh</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">{derivativeOpps.length}</div>
          <div class="stat-label">Derivative Opps</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">{monetizationGaps.length}</div>
          <div class="stat-label">Monetization Gaps</div>
        </div>
      </div>
    </section>

    <!-- Best Evergreen Posts -->
    <section class="admin-section">
      <h2>Best Evergreen Posts ({bestEvergreen.length})</h2>
      {bestEvergreen.length > 0 ? (
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Title</th>
                <th>Evergreen</th>
                <th>Distribution</th>
                <th>Monetization</th>
                <th>Derivative</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              {bestEvergreen.slice(0, 30).map(p => {
                const [pillar, ...rest] = p.id.split('/');
                const slug = rest.join('/');
                return (
                  <tr>
                    <td><a href={`${base}/${pillar}/${slug}/`} target="_blank">{p.data.title}</a></td>
                    <td class="score">{p.data.evergreenScore}</td>
                    <td class="score">{p.data.distributionScore}</td>
                    <td class="score">{p.data.monetizationScore}</td>
                    <td class="score">{p.data.derivativeScore}</td>
                    <td class="actions-cell">
                      <button class="btn btn-sm api-action" data-endpoint="/api/refresh-brief" data-slug={p.id}>Refresh</button>
                      <button class="btn btn-sm api-action" data-endpoint="/api/derivative" data-slug={p.id}>Derive</button>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="empty-state">No evergreen posts scored yet. Run classification first.</p>
      )}
      <div class="result-panel" style="display:none;"></div>
    </section>

    <!-- Refresh Queue -->
    <section class="admin-section">
      <h2>Refresh Queue ({refreshQueue.length})</h2>
      {refreshQueue.length > 0 ? (
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Title</th>
                <th>Priority</th>
                <th>Last Refreshed</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              {refreshQueue.slice(0, 20).map(p => (
                <tr>
                  <td>{p.data.title}</td>
                  <td><span class={`priority priority-${p.data.refreshPriority}`}>{p.data.refreshPriority}</span></td>
                  <td>{p.data.refreshedDate || 'Never'}</td>
                  <td class="actions-cell">
                    <button class="btn btn-sm api-action" data-endpoint="/api/refresh-brief" data-slug={p.id}>Generate Refresh Brief</button>
                    <button class="btn btn-sm api-action" data-endpoint="/api/mark-refreshed" data-slug={p.id}>Mark Refreshed</button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="empty-state">No posts in the refresh queue.</p>
      )}
      <div class="result-panel" style="display:none;"></div>
    </section>

    <!-- Derivative Opportunities -->
    <section class="admin-section">
      <h2>Derivative Opportunities ({derivativeOpps.length})</h2>
      {derivativeOpps.length > 0 ? (
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Title</th>
                <th>Score</th>
                <th>Suggested Derivatives</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              {derivativeOpps.slice(0, 20).map(p => (
                <tr>
                  <td>{p.data.title}</td>
                  <td class="score">{p.data.derivativeScore}</td>
                  <td>{p.data.suggestedDerivatives.length > 0 ? p.data.suggestedDerivatives.join(', ') : 'None suggested'}</td>
                  <td>
                    <button class="btn btn-sm api-action" data-endpoint="/api/derivative" data-slug={p.id}>Generate Derivative Brief</button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="empty-state">No derivative opportunities above threshold.</p>
      )}
      <div class="result-panel" style="display:none;"></div>
    </section>

    <!-- Monetization Gaps -->
    <section class="admin-section">
      <h2>Monetization Gaps ({monetizationGaps.length})</h2>
      {monetizationGaps.length > 0 ? (
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Title</th>
                <th>Potential</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              {monetizationGaps.map(p => (
                <tr>
                  <td>{p.data.title}</td>
                  <td><span class="priority priority-high">{p.data.monetizationPotential}</span></td>
                  <td>
                    <button class="btn btn-sm api-action" data-endpoint="/api/affiliate-suggest" data-slug={p.id}>Add Affiliate Block</button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="empty-state">No monetization gaps found.</p>
      )}
      <div class="result-panel" style="display:none;"></div>
    </section>

    <!-- Re-share Queue -->
    <section class="admin-section">
      <h2>Re-share Queue ({reshareQueue.length})</h2>
      {reshareQueue.length > 0 ? (
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Title</th>
                <th>Evergreen Score</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              {reshareQueue.slice(0, 20).map(p => (
                <tr>
                  <td>{p.data.title}</td>
                  <td class="score">{p.data.evergreenScore}</td>
                  <td class="actions-cell">
                    <button class="btn btn-sm api-action" data-endpoint="/api/newsletter-copy" data-slug={p.id}>Newsletter Copy</button>
                    <button class="btn btn-sm api-action" data-endpoint="/api/social-copy" data-slug={p.id}>Social Copy</button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="empty-state">All evergreen posts have been included in the newsletter.</p>
      )}
      <div class="result-panel" style="display:none;"></div>
    </section>
  </div>
</Base>

<style>
  .admin-wrap { max-width: 1200px; margin: 0 auto; padding: 2rem 1.5rem; font-family: 'Inter', -apple-system, sans-serif; }
  .admin-header { margin-bottom: 1rem; border-bottom: 3px solid #000; padding-bottom: 1rem; }
  .admin-header h1 { font-family: 'Playfair Display', Georgia, serif; font-size: 2rem; margin: 0; }
  .admin-nav { display: flex; flex-wrap: wrap; gap: 0.25rem; margin-bottom: 2rem; border-bottom: 1px solid #e8e8e8; padding-bottom: 0.75rem; }
  .admin-nav a { padding: 0.4rem 0.75rem; text-decoration: none; color: #666; font-size: 0.85rem; border-radius: 4px; transition: all 0.15s; }
  .admin-nav a:hover { background: #f5f5f5; color: #000; }
  .admin-nav a.active { background: #000; color: #fff; }
  .admin-section { margin-bottom: 2.5rem; }
  .admin-section h2 { font-family: 'Playfair Display', Georgia, serif; font-size: 1.3rem; margin: 0 0 1rem; border-bottom: 1px solid #e8e8e8; padding-bottom: 0.5rem; }
  .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 1rem; }
  .stat-card { background: #f5f5f5; padding: 1rem; text-align: center; border: 1px solid #e8e8e8; }
  .stat-number { font-size: 1.75rem; font-weight: 700; color: #000; }
  .stat-label { font-size: 0.75rem; color: #666; text-transform: uppercase; letter-spacing: 0.05em; }
  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
  th, td { text-align: left; padding: 0.5rem 0.6rem; border-bottom: 1px solid #e8e8e8; }
  th { font-weight: 600; text-transform: uppercase; font-size: 0.65rem; letter-spacing: 0.05em; color: #666; background: #f5f5f5; }
  td a { color: #000; }
  .score { font-weight: 700; font-family: monospace; }
  .priority { font-size: 0.7rem; padding: 0.15rem 0.4rem; text-transform: uppercase; font-weight: 600; }
  .priority-high { background: #000; color: #fff; }
  .priority-medium { background: #666; color: #fff; }
  .priority-low { background: #e8e8e8; color: #666; }
  .priority-none { background: #f5f5f5; color: #999; }
  .actions-cell { white-space: nowrap; }
  .btn { padding: 0.4rem 0.75rem; border: 1px solid #000; cursor: pointer; font-size: 0.75rem; font-family: inherit; transition: all 0.15s; text-decoration: none; display: inline-block; background: #fff; color: #000; }
  .btn-sm { padding: 0.2rem 0.4rem; font-size: 0.7rem; }
  .btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .result-panel { margin-top: 1rem; padding: 1rem; background: #f5f5f5; border: 1px solid #e8e8e8; font-size: 0.85rem; white-space: pre-wrap; max-height: 400px; overflow-y: auto; font-family: monospace; }
  .empty-state { color: #999; font-style: italic; font-size: 0.9rem; }
</style>

<script>
  const API_BASE = 'http://localhost:3001';

  async function apiCall(endpoint: string, method = 'POST', body?: object) {
    try {
      const res = await fetch(`${API_BASE}${endpoint}`, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: body ? JSON.stringify(body) : undefined,
      });
      if (!res.ok) throw new Error(`API error: ${res.status}`);
      return await res.json();
    } catch (e: any) {
      return { error: true, message: e.message || 'API unavailable. Is the growth engine running on localhost:3001?' };
    }
  }

  document.querySelectorAll('.api-action').forEach(btn => {
    btn.addEventListener('click', async () => {
      const endpoint = (btn as HTMLElement).dataset.endpoint!;
      const slug = (btn as HTMLElement).dataset.slug;
      const origText = btn.textContent;
      btn.textContent = 'Working...';
      (btn as HTMLButtonElement).disabled = true;
      const result = await apiCall(endpoint, 'POST', slug ? { slug } : undefined);
      const panel = btn.closest('.admin-section')?.querySelector('.result-panel');
      if (panel) {
        (panel as HTMLElement).style.display = 'block';
        (panel as HTMLElement).textContent = JSON.stringify(result, null, 2);
      }
      btn.textContent = origText;
      (btn as HTMLButtonElement).disabled = false;
    });
  });
</script>
