---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AdminActions from '../../components/AdminActions.astro';

const allPosts = await getCollection('posts');
const published = allPosts.filter(p => !p.data.draft);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Pillar coverage
const pillarCounts: Record<string, number> = {};
const knownPillars = ['business', 'culture', 'finance', 'tech', 'travel', 'lifestyle', 'food', 'entertainment'];
for (const p of knownPillars) pillarCounts[p] = 0;
for (const p of published) {
  pillarCounts[p.data.pillar] = (pillarCounts[p.data.pillar] || 0) + 1;
}
const emptyPillars = Object.entries(pillarCounts).filter(([, count]) => count === 0);
const underservedPillars = Object.entries(pillarCounts).filter(([, count]) => count > 0 && count < 5);

// Recent posts for follow-up suggestions
const recent = [...published]
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 10);

// Tag coverage
const tagCounts: Record<string, number> = {};
for (const p of published) {
  const keyword = p.data.targetKeyword;
  if (keyword) tagCounts[keyword] = (tagCounts[keyword] || 0) + 1;
}
const sortedTags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);
---

<Base title="Content Opportunities | Admin" noindex={true}>
  <div class="admin-layout">
    <h1>Content Opportunities</h1>
    <p class="admin-subtitle">Gaps, clusters, and growth areas</p>

    <span id="api-status" class="api-status api-status--offline">Checking API...</span>

    <div class="admin-actions-bar">
      <button class="admin-btn" data-action="plan">Generate Content Plan</button>
    </div>
    <pre id="action-output"></pre>

    <nav class="admin-nav">
      <a href={`${base}/admin/`} class="admin-nav-link">Editorial</a>
      <a href={`${base}/admin/posts/`} class="admin-nav-link">All Posts</a>
      <a href={`${base}/admin/calendar/`} class="admin-nav-link">Calendar</a>
      <a href={`${base}/admin/archive/`} class="admin-nav-link">Archive</a>
      <a href={`${base}/admin/seo/`} class="admin-nav-link">SEO</a>
      <a href={`${base}/admin/opportunities/`} class="admin-nav-link active">Opportunities</a>
      <a href={`${base}/admin/distribution/`} class="admin-nav-link">Distribution</a>
      <a href={`${base}/admin/monetization/`} class="admin-nav-link">Monetization</a>
      <a href={`${base}/admin/performance/`} class="admin-nav-link">Performance</a>
    </nav>

    <!-- Stats row -->
    <div class="admin-stats-grid">
      <div class="admin-stat">
        <span class="admin-stat-number">{published.length}</span>
        <span class="admin-stat-label">Published Posts</span>
      </div>
      <div class="admin-stat">
        <span class="admin-stat-number">{knownPillars.length - emptyPillars.length}</span>
        <span class="admin-stat-label">Active Pillars</span>
      </div>
      <div class="admin-stat">
        <span class="admin-stat-number">{underservedPillars.length}</span>
        <span class="admin-stat-label">Underserved Pillars</span>
      </div>
      <div class="admin-stat">
        <span class="admin-stat-number">{sortedTags.length}</span>
        <span class="admin-stat-label">Unique Topics</span>
      </div>
    </div>

    <!-- Pillar Coverage -->
    <div class="admin-card">
      <h2>Pillar Coverage</h2>
      <div class="admin-bar-chart">
        {Object.entries(pillarCounts).sort((a, b) => b[1] - a[1]).map(([pillar, count]) => (
          <div class="admin-bar-row">
            <span class="admin-bar-label">{pillar.charAt(0).toUpperCase() + pillar.slice(1)}</span>
            <div class="admin-bar-track">
              <div class={`admin-bar-fill ${count === 0 ? 'voice-score--bad' : ''}`} style={`width: ${published.length > 0 ? Math.max(Math.round(count / published.length * 100), count > 0 ? 3 : 0) : 0}%`}></div>
            </div>
            <span class="admin-bar-count">{count}</span>
          </div>
        ))}
      </div>
      {emptyPillars.length > 0 && (
        <p class="admin-alert-text">Empty pillars: {emptyPillars.map(([p]) => p).join(', ')}</p>
      )}
    </div>

    <!-- Top Topics -->
    {sortedTags.length > 0 && (
      <div class="admin-card">
        <h2>Top Topics</h2>
        <table class="admin-table">
          <thead>
            <tr>
              <th>Topic</th>
              <th>Posts</th>
            </tr>
          </thead>
          <tbody>
            {sortedTags.slice(0, 20).map(([tag, count]) => (
              <tr>
                <td>{tag}</td>
                <td>{count}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    <!-- Recent Posts -->
    <div class="admin-card">
      <h2>Recent Posts</h2>
      <table class="admin-table">
        <thead>
          <tr>
            <th>Title</th>
            <th>Pillar</th>
            <th>Date</th>
          </tr>
        </thead>
        <tbody>
          {recent.map(p => (
            <tr>
              <td>{p.data.title}</td>
              <td><span class="status-badge">{p.data.pillar}</span></td>
              <td>{p.data.date}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
  <AdminActions />
</Base>
