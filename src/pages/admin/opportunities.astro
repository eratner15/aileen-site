---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AdminNav from '../../components/AdminNav.astro';
import AdminOutput from '../../components/AdminOutput.astro';
import destinations from '../../data/destinations.json';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Destination gaps: destinations with fewer than 3 posts
const destCoverage = destinations.map(d => {
  const posts = allPosts.filter(p => p.data.destinations?.includes(d.slug));
  return { ...d, count: posts.length, types: [...new Set(posts.map(p => p.data.contentType || 'article'))] };
});
const thinDests = destCoverage.filter(d => d.count < 3);

// Content type gaps per destination
type Gap = { dest: string; type: string; suggestion: string };
const contentGaps: Gap[] = [];
const expectedTypes = ['restaurant-guide', 'hotel-review', 'travel-guide', 'style-guide'];
for (const d of destCoverage.filter(dc => dc.count > 0)) {
  for (const t of expectedTypes) {
    if (!d.types.includes(t)) {
      const typeLabels: Record<string, string> = { 'restaurant-guide': 'Best Restaurants', 'hotel-review': 'Where to Stay', 'travel-guide': 'Travel Guide', 'style-guide': 'What to Wear' };
      contentGaps.push({ dest: d.label, type: t, suggestion: `${typeLabels[t]} in ${d.label}` });
    }
  }
}

// Cornerstone gaps
const pillars = ['travel', 'style', 'recipes', 'lifestyle'];
const pillarCornerstones = pillars.map(p => ({
  pillar: p,
  cornerstone: allPosts.filter(post => post.data.pillar === p && post.data.cornerstone).length,
  total: allPosts.filter(post => post.data.pillar === p).length,
}));
const missingCornerstones = pillarCornerstones.filter(p => p.cornerstone === 0 && p.total > 0);

// Refresh opportunities
const sixMonthsAgo = new Date();
sixMonthsAgo.setMonth(sixMonthsAgo.getMonth() - 6);
const refreshOpps = allPosts
  .filter(p => new Date(p.data.updatedDate || p.data.date) < sixMonthsAgo)
  .sort((a, b) => new Date(a.data.updatedDate || a.data.date).getTime() - new Date(b.data.updatedDate || b.data.date).getTime());

// Monetization gaps
const monetizationGaps = allPosts.filter(p =>
  ['restaurant-guide', 'hotel-review', 'the-edit', 'style-guide'].includes(p.data.contentType || '') &&
  p.data.products.length === 0 && p.data.bookingLinks.length === 0 && p.data.reservationLinks.length === 0
);
---

<Base title="Opportunities | Admin" noindex={true} isAdmin={true}>
  <div class="admin-layout">
    <h1>Growth Opportunities</h1>
    <p class="admin-subtitle">Strategic gaps to fill and content to build next.</p>

    <AdminNav active="opportunities" />

    <div class="admin-stats-grid">
      <div class="admin-stat">
        <span class="admin-stat-number">{contentGaps.length}</span>
        <span class="admin-stat-label">Content Type Gaps</span>
      </div>
      <div class="admin-stat">
        <span class="admin-stat-number">{thinDests.length}</span>
        <span class="admin-stat-label">Thin Destinations</span>
      </div>
      <div class="admin-stat">
        <span class="admin-stat-number">{refreshOpps.length}</span>
        <span class="admin-stat-label">Refresh Opps</span>
      </div>
      <div class="admin-stat">
        <span class="admin-stat-number">{monetizationGaps.length}</span>
        <span class="admin-stat-label">Monetization Gaps</span>
      </div>
    </div>

    <!-- Content type gaps -->
    {contentGaps.length > 0 && (
      <div class="admin-card" style="border-left: 3px solid var(--color-text);">
        <h2>Content Gaps by Destination</h2>
        <p style="font-family: var(--font-ui); font-size: 0.82rem; color: var(--color-text-muted); margin-bottom: 1rem;">
          Destinations where key content types are missing. Each gap is an article opportunity.
        </p>
        <div class="priority-list">
          {contentGaps.slice(0, 12).map(gap => (
            <div class="priority-item">
              <div class="priority-item-signal">
                <h4>{gap.suggestion}</h4>
                <p>Missing {gap.type.replace(/-/g, ' ')} for {gap.dest}</p>
              </div>
              <div class="priority-item-actions">
                <button class="admin-btn admin-btn--small" data-api-action="outline" data-title={gap.suggestion}>Generate Brief</button>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Destination coverage -->
    <div class="admin-card">
      <h2>Destination Coverage</h2>
      <table class="admin-table">
        <thead>
          <tr>
            <th>Destination</th>
            <th>Posts</th>
            <th>Content Types</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          {destCoverage.map(d => (
            <tr>
              <td>{d.label}</td>
              <td>{d.count}</td>
              <td style="font-family: var(--font-ui); font-size: 0.72rem;">{d.types.join(', ') || '—'}</td>
              <td>
                {d.count === 0 ? (
                  <span class="status-badge status-badge--error">Empty</span>
                ) : d.count < 3 ? (
                  <span class="status-badge status-badge--warning">Thin</span>
                ) : (
                  <span class="status-badge status-badge--success">Good</span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Refresh opportunities -->
    {refreshOpps.length > 0 && (
      <div class="admin-card admin-card--alert">
        <h2>Refresh Opportunities ({refreshOpps.length})</h2>
        <p style="font-family: var(--font-ui); font-size: 0.82rem; color: var(--color-text-muted); margin-bottom: 1rem;">
          Posts older than 6 months without an update. Refreshing can boost rankings.
        </p>
        <table class="admin-table">
          <thead>
            <tr><th>Title</th><th>Last Updated</th><th>Actions</th></tr>
          </thead>
          <tbody>
            {refreshOpps.slice(0, 8).map(p => (
              <tr>
                <td>{p.data.title}</td>
                <td>{p.data.updatedDate || p.data.date}</td>
                <td>
                  <button class="admin-btn admin-btn--small" data-api-action="refresh" data-title={p.data.title} data-keyword={p.data.targetKeyword}>Refresh Brief</button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    <!-- Missing cornerstone -->
    {missingCornerstones.length > 0 && (
      <div class="admin-card">
        <h2>Missing Cornerstones</h2>
        <p style="font-family: var(--font-ui); font-size: 0.82rem; color: var(--color-text-muted); margin-bottom: 0.75rem;">
          Pillars with content but no cornerstone article. Cornerstones are essential for hub-and-spoke SEO.
        </p>
        {missingCornerstones.map(p => (
          <p style="font-family: var(--font-ui); font-size: 0.85rem;">
            <strong>{p.pillar.charAt(0).toUpperCase() + p.pillar.slice(1)}</strong> — {p.total} posts, no cornerstone
          </p>
        ))}
      </div>
    )}

    <!-- Keywords (from API) -->
    <div class="admin-card" id="keywords-card">
      <h2>Top Keyword Opportunities</h2>
      <p style="font-family: var(--font-ui); font-size: 0.82rem; color: var(--color-text-muted); margin-bottom: 1rem;">
        Unassigned keywords ranked by opportunity score. <span style="font-style: italic;">Requires growth engine API.</span>
      </p>
      <div id="keywords-list" style="font-family: var(--font-ui); font-size: 0.82rem; color: var(--color-text-muted);">Loading keywords...</div>
    </div>
  </div>

  <AdminOutput />

  <script>
    const API_URL = localStorage.getItem('aileen_api_url') || 'http://localhost:3001';
    const output = (window as any).adminOutput;

    async function loadKeywords() {
      const el = document.getElementById('keywords-list');
      try {
        const res = await fetch(`${API_URL}/api/keywords`, { signal: AbortSignal.timeout(3000) });
        const data = await res.json();
        if (data.keywords?.length > 0) {
          el!.innerHTML = '<table class="admin-table"><thead><tr><th>Keyword</th><th>Volume</th><th>Difficulty</th><th>Pillar</th><th>Score</th></tr></thead><tbody>' +
            data.keywords.map((k: any) =>
              `<tr><td>${k.keyword}</td><td>${k.search_volume || '—'}</td><td>${k.difficulty || '—'}</td><td>${k.pillar || '—'}</td><td>${k.opportunity_score?.toFixed(1) || '—'}</td></tr>`
            ).join('') + '</tbody></table>';
        } else {
          el!.textContent = 'No unassigned keywords found. Add keywords via: aileen seed-keywords';
        }
      } catch {
        el!.textContent = 'Could not connect to growth engine API. Run: aileen serve';
      }
    }

    loadKeywords();

    // API action buttons
    document.querySelectorAll('[data-api-action]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const el = btn as HTMLElement;
        const action = el.dataset.apiAction!;
        const title = el.dataset.title || '';
        const keyword = el.dataset.keyword || '';

        let endpoint = action;
        let body: any = { title, keyword };

        switch (action) {
          case 'outline':
            body = { topic: title };
            break;
          case 'refresh':
            body = { title, keyword };
            break;
        }

        const label = action.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
        output.show(`${label}: ${title}`);
        el.classList.add('admin-btn--loading');

        try {
          const res = await fetch(`${API_URL}/api/${endpoint}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
          });
          output.setRaw(await res.json());
        } catch {
          output.setError('Could not connect to API. Run: aileen serve');
        }
        el.classList.remove('admin-btn--loading');
      });
    });
  </script>
</Base>

<style>
  .admin-btn--loading {
    opacity: 0.5;
    pointer-events: none;
  }
</style>
