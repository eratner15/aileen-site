---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Revenue stats
const withProducts = allPosts.filter(p => p.data.products.length > 0);
const withBooking = allPosts.filter(p => p.data.bookingLinks.length > 0);
const withReservation = allPosts.filter(p => p.data.reservationLinks.length > 0);
const withAffiliate = allPosts.filter(p => p.data.affiliateDisclosure);
const totalProducts = allPosts.reduce((s, p) => s + p.data.products.length, 0);

// High-potential unmonetized
const highUnmonetized = allPosts
  .filter(p => p.data.monetizationPotential === 'high' && p.data.products.length === 0)
  .sort((a, b) => b.data.monetizationScore - a.data.monetizationScore);

// Existing monetization
const monetizedPosts = allPosts
  .filter(p => p.data.products.length > 0 || p.data.bookingLinks.length > 0 || p.data.reservationLinks.length > 0)
  .sort((a, b) => (b.data.products.length + b.data.bookingLinks.length + b.data.reservationLinks.length) -
                   (a.data.products.length + a.data.bookingLinks.length + a.data.reservationLinks.length));

// Stack page opportunities (high derivative + high monetization)
const stackOpps = allPosts
  .filter(p => p.data.derivativePotential === 'high' && p.data.monetizationPotential === 'high')
  .sort((a, b) => (b.data.derivativeScore + b.data.monetizationScore) - (a.data.derivativeScore + a.data.monetizationScore));

// Affiliate disclosure check: has products but no disclosure
const missingDisclosure = allPosts
  .filter(p => (p.data.products.length > 0 || p.data.bookingLinks.length > 0) && !p.data.affiliateDisclosure);
---

<Base title="Revenue Engine | Admin" noindex={true}>
  <div class="admin-wrap">
    <div class="admin-header">
      <h1>Revenue Engine</h1>
    </div>

    <nav class="admin-nav">
      <a href={`${base}/admin/`}>Command Center</a>
      <a href={`${base}/admin/content/`}>Content</a>
      <a href={`${base}/admin/archive/`}>Evergreen</a>
      <a href={`${base}/admin/seo/`}>SEO</a>
      <a href={`${base}/admin/distribution/`}>Distribution</a>
      <a href={`${base}/admin/revenue/`} class="active">Revenue</a>
      <a href={`${base}/admin/performance/`}>Performance</a>
      <a href={`${base}/admin/ai-assist/`}>AI Assist</a>
      <a href={`${base}/admin/settings/`}>Settings</a>
    </nav>

    <!-- Revenue Opportunity Summary -->
    <section class="admin-section">
      <h2>Revenue Opportunity Summary</h2>
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-number">{highUnmonetized.length}</div>
          <div class="stat-label">High-Potential Unmonetized</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">{totalProducts}</div>
          <div class="stat-label">Total Products</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">{withBooking.length}</div>
          <div class="stat-label">With Booking Links</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">{withReservation.length}</div>
          <div class="stat-label">With Reservation Links</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">{withAffiliate.length}</div>
          <div class="stat-label">With Affiliate Disclosure</div>
        </div>
      </div>
    </section>

    <!-- High-Potential Unmonetized -->
    <section class="admin-section">
      <h2>High-Potential Unmonetized ({highUnmonetized.length})</h2>
      {highUnmonetized.length > 0 ? (
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Title</th>
                <th>Monetization Score</th>
                <th>Pillar</th>
                <th>Suggested Affiliates</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              {highUnmonetized.map(p => (
                <tr>
                  <td>{p.data.title}</td>
                  <td class="score">{p.data.monetizationScore}</td>
                  <td>{p.data.pillar}</td>
                  <td>{p.data.suggestedAffiliates.length > 0 ? p.data.suggestedAffiliates.join(', ') : 'None yet'}</td>
                  <td class="actions-cell">
                    <button class="btn btn-sm api-action" data-endpoint="/api/affiliate-suggest" data-slug={p.id}>Suggest Affiliates</button>
                    <button class="btn btn-sm api-action" data-endpoint="/api/add-cta" data-slug={p.id}>Add CTA</button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="empty-state">No high-potential unmonetized posts.</p>
      )}
      <div class="result-panel" style="display:none;"></div>
    </section>

    <!-- Existing Monetization -->
    <section class="admin-section">
      <h2>Existing Monetization ({monetizedPosts.length})</h2>
      {monetizedPosts.length > 0 ? (
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Title</th>
                <th>Products</th>
                <th>Booking</th>
                <th>Reservations</th>
                <th>Disclosure</th>
              </tr>
            </thead>
            <tbody>
              {monetizedPosts.map(p => (
                <tr>
                  <td>{p.data.title}</td>
                  <td>{p.data.products.length}</td>
                  <td>{p.data.bookingLinks.length}</td>
                  <td>{p.data.reservationLinks.length}</td>
                  <td class={p.data.affiliateDisclosure ? 'check-pass' : 'check-fail'}>
                    {p.data.affiliateDisclosure ? 'Yes' : 'No'}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="empty-state">No monetized posts yet.</p>
      )}
    </section>

    <!-- Stack Page Opportunities -->
    <section class="admin-section">
      <h2>Stack Page Opportunities ({stackOpps.length})</h2>
      <p class="section-desc">Posts that could become tool/resource pages (high derivative + high monetization potential)</p>
      {stackOpps.length > 0 ? (
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Title</th>
                <th>Derivative Score</th>
                <th>Monetization Score</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              {stackOpps.map(p => (
                <tr>
                  <td>{p.data.title}</td>
                  <td class="score">{p.data.derivativeScore}</td>
                  <td class="score">{p.data.monetizationScore}</td>
                  <td>
                    <button class="btn btn-sm api-action" data-endpoint="/api/derivative" data-slug={p.id}>Create Stack Page</button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="empty-state">No stack page opportunities found.</p>
      )}
      <div class="result-panel" style="display:none;"></div>
    </section>

    <!-- Affiliate Disclosure Check -->
    <section class="admin-section">
      <h2>Affiliate Disclosure Check ({missingDisclosure.length} missing)</h2>
      {missingDisclosure.length > 0 ? (
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Title</th>
                <th>Products</th>
                <th>Booking Links</th>
                <th>Issue</th>
              </tr>
            </thead>
            <tbody>
              {missingDisclosure.map(p => (
                <tr>
                  <td>{p.data.title}</td>
                  <td>{p.data.products.length}</td>
                  <td>{p.data.bookingLinks.length}</td>
                  <td class="check-fail">Missing affiliateDisclosure: true</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="empty-state">All monetized posts have affiliate disclosure set.</p>
      )}
    </section>
  </div>
</Base>

<style>
  .admin-wrap { max-width: 1200px; margin: 0 auto; padding: 2rem 1.5rem; font-family: 'Inter', -apple-system, sans-serif; }
  .admin-header { margin-bottom: 1rem; border-bottom: 3px solid #000; padding-bottom: 1rem; }
  .admin-header h1 { font-family: 'Playfair Display', Georgia, serif; font-size: 2rem; margin: 0; }
  .admin-nav { display: flex; flex-wrap: wrap; gap: 0.25rem; margin-bottom: 2rem; border-bottom: 1px solid #e8e8e8; padding-bottom: 0.75rem; }
  .admin-nav a { padding: 0.4rem 0.75rem; text-decoration: none; color: #666; font-size: 0.85rem; border-radius: 4px; transition: all 0.15s; }
  .admin-nav a:hover { background: #f5f5f5; color: #000; }
  .admin-nav a.active { background: #000; color: #fff; }
  .admin-section { margin-bottom: 2.5rem; }
  .admin-section h2 { font-family: 'Playfair Display', Georgia, serif; font-size: 1.3rem; margin: 0 0 1rem; border-bottom: 1px solid #e8e8e8; padding-bottom: 0.5rem; }
  .section-desc { font-size: 0.85rem; color: #666; margin: -0.5rem 0 1rem; }
  .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 1rem; }
  .stat-card { background: #f5f5f5; padding: 1rem; text-align: center; border: 1px solid #e8e8e8; }
  .stat-number { font-size: 1.75rem; font-weight: 700; color: #000; }
  .stat-label { font-size: 0.7rem; color: #666; text-transform: uppercase; letter-spacing: 0.05em; }
  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
  th, td { text-align: left; padding: 0.5rem 0.6rem; border-bottom: 1px solid #e8e8e8; }
  th { font-weight: 600; text-transform: uppercase; font-size: 0.65rem; letter-spacing: 0.05em; color: #666; background: #f5f5f5; }
  .score { font-weight: 700; font-family: monospace; }
  .check-pass { color: #22c55e; font-weight: 600; }
  .check-fail { color: #ef4444; font-weight: 600; }
  .actions-cell { white-space: nowrap; }
  .btn { padding: 0.4rem 0.75rem; border: 1px solid #000; cursor: pointer; font-size: 0.75rem; font-family: inherit; transition: all 0.15s; text-decoration: none; display: inline-block; background: #fff; color: #000; }
  .btn-primary { background: #000; color: #fff; }
  .btn-sm { padding: 0.2rem 0.4rem; font-size: 0.7rem; }
  .btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .result-panel { margin-top: 1rem; padding: 1rem; background: #f5f5f5; border: 1px solid #e8e8e8; font-size: 0.85rem; white-space: pre-wrap; max-height: 400px; overflow-y: auto; font-family: monospace; }
  .empty-state { color: #999; font-style: italic; font-size: 0.9rem; }
</style>

<script>
  const API_BASE = 'http://localhost:3001';

  async function apiCall(endpoint: string, method = 'POST', body?: object) {
    try {
      const res = await fetch(`${API_BASE}${endpoint}`, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: body ? JSON.stringify(body) : undefined,
      });
      if (!res.ok) throw new Error(`API error: ${res.status}`);
      return await res.json();
    } catch (e: any) {
      return { error: true, message: e.message || 'API unavailable. Is the growth engine running on localhost:3001?' };
    }
  }

  document.querySelectorAll('.api-action').forEach(btn => {
    btn.addEventListener('click', async () => {
      const endpoint = (btn as HTMLElement).dataset.endpoint!;
      const slug = (btn as HTMLElement).dataset.slug;
      const origText = btn.textContent;
      btn.textContent = 'Working...';
      (btn as HTMLButtonElement).disabled = true;
      const result = await apiCall(endpoint, 'POST', slug ? { slug } : undefined);
      const panel = btn.closest('.admin-section')?.querySelector('.result-panel');
      if (panel) {
        (panel as HTMLElement).style.display = 'block';
        (panel as HTMLElement).textContent = JSON.stringify(result, null, 2);
      }
      btn.textContent = origText;
      (btn as HTMLButtonElement).disabled = false;
    });
  });
</script>
