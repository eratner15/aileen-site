---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AdminNav from '../../components/AdminNav.astro';
import AdminOutput from '../../components/AdminOutput.astro';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// SEO audit per post
type SeoIssue = { label: string; severity: 'red' | 'yellow' | 'green'; action: string };
type SeoAudit = { post: typeof allPosts[0]; issues: SeoIssue[]; score: number };

const audits: SeoAudit[] = allPosts.map(post => {
  const issues: SeoIssue[] = [];
  let score = 0;
  const checks: { ok: boolean; label: string; action: string }[] = [
    { ok: !!post.data.title && post.data.title.length <= 60, label: 'Title length', action: 'generate-title' },
    { ok: !!post.data.metaDescription && post.data.metaDescription.length >= 120 && post.data.metaDescription.length <= 160, label: 'Meta description', action: 'generate-meta' },
    { ok: !!post.data.imageAlt && post.data.imageAlt.length > 5, label: 'Hero alt text', action: 'generate-alt' },
    { ok: !!(post.data.faq && post.data.faq.length > 0), label: 'FAQ section', action: 'generate-faq' },
    { ok: !!(post.data.destinations && post.data.destinations.length > 0), label: 'Destination assigned', action: 'assign-dest' },
    { ok: !!(post.data.contentType && post.data.contentType !== 'article'), label: 'Content type set', action: 'assign-type' },
    { ok: !!post.data.updatedDate, label: 'Updated date', action: 'mark-updated' },
    { ok: !!post.data.toc || (post.body?.split(/\s+/).length || 0) < 1500, label: 'TOC on long content', action: 'add-toc' },
    { ok: !!(post.data.relatedPosts && post.data.relatedPosts.length > 0), label: 'Manual related posts', action: 'suggest-links' },
    { ok: !!(post.data.ogTitle || post.data.title), label: 'OG title', action: 'generate-og' },
  ];

  for (const check of checks) {
    if (check.ok) {
      score += 10;
      issues.push({ label: check.label, severity: 'green', action: check.action });
    } else {
      issues.push({ label: check.label, severity: 'red', action: check.action });
    }
  }

  return { post, issues, score };
}).sort((a, b) => a.score - b.score);

function postUrl(post: typeof allPosts[0]) {
  const [pillar, ...rest] = post.id.split('/');
  return `${base}/${pillar}/${rest.join('/')}/`;
}
---

<Base title="SEO Console | Admin" noindex={true} isAdmin={true}>
  <div class="admin-layout">
    <h1>SEO Repair Console</h1>
    <p class="admin-subtitle">Fix issues. Generate improvements. No inflated scores.</p>

    <AdminNav active="seo" />

    <div class="admin-stats-grid">
      <div class="admin-stat">
        <span class="admin-stat-number">{audits.filter(a => a.score >= 80).length}</span>
        <span class="admin-stat-label">SEO Strong (80+)</span>
      </div>
      <div class="admin-stat">
        <span class="admin-stat-number">{audits.filter(a => a.score >= 50 && a.score < 80).length}</span>
        <span class="admin-stat-label">Needs Work (50-79)</span>
      </div>
      <div class="admin-stat">
        <span class="admin-stat-number">{audits.filter(a => a.score < 50).length}</span>
        <span class="admin-stat-label">Urgent (&lt;50)</span>
      </div>
    </div>

    {audits.map(audit => {
      const redCount = audit.issues.filter(i => i.severity === 'red').length;
      const scoreColor = audit.score >= 80 ? 'var(--color-success)' : audit.score >= 50 ? 'var(--color-warning)' : 'var(--color-error)';
      return (
        <div class="admin-card" style={redCount > 3 ? 'border-left: 3px solid var(--color-error);' : ''}>
          <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem;">
            <div>
              <h3 style="margin: 0 0 0.25rem;">
                <a href={postUrl(audit.post)} style="text-decoration:none; color: inherit; border-bottom: 1px solid var(--color-border);">{audit.post.data.title}</a>
              </h3>
              <p style="font-family: var(--font-ui); font-size: 0.72rem; color: var(--color-text-muted); margin: 0;">
                {audit.post.data.pillar} &middot; {(audit.post.data.contentType || 'article').replace(/-/g, ' ')}
              </p>
            </div>
            <div style={`font-family: var(--font-display); font-size: 1.8rem; font-weight: 500; color: ${scoreColor}; line-height: 1;`}>
              {audit.score}
            </div>
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem;">
            {audit.issues.filter(i => i.severity === 'red').map(issue => (
              <div style="display: flex; align-items: center; gap: 0.35rem;">
                <span style="width: 6px; height: 6px; border-radius: 50%; background: var(--color-error); flex-shrink: 0;"></span>
                <span style="font-family: var(--font-ui); font-size: 0.72rem; color: var(--color-text-secondary);">{issue.label}</span>
                <button class="admin-btn admin-btn--small" data-seo-action={issue.action} data-post={audit.post.id} data-title={audit.post.data.title} data-keyword={audit.post.data.targetKeyword} style="font-size: 0.55rem; padding: 0.2rem 0.5rem;">Fix</button>
              </div>
            ))}
            {audit.issues.filter(i => i.severity === 'green').map(issue => (
              <div style="display: flex; align-items: center; gap: 0.35rem;">
                <span style="width: 6px; height: 6px; border-radius: 50%; background: var(--color-success); flex-shrink: 0;"></span>
                <span style="font-family: var(--font-ui); font-size: 0.72rem; color: var(--color-text-muted);">{issue.label}</span>
              </div>
            ))}
          </div>
        </div>
      );
    })}

    <p style="font-family: var(--font-ui); font-size: 0.72rem; color: var(--color-text-muted); margin-top: 1rem;">
      Score: 10 points per passing check (10 checks). No weighted inflation. Red items need attention.
    </p>
  </div>

  <AdminOutput />

  <script>
    const API_URL = localStorage.getItem('aileen_api_url') || 'http://localhost:3001';
    const output = (window as any).adminOutput;

    document.querySelectorAll('[data-seo-action]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const el = btn as HTMLElement;
        const action = el.dataset.seoAction!;
        const title = el.dataset.title || '';
        const keyword = el.dataset.keyword || '';

        let endpoint = 'audit';
        let body: any = { action, title, keyword };

        switch (action) {
          case 'generate-title':
            endpoint = 'titles';
            body = { keyword: keyword || title };
            break;
          case 'generate-meta':
            endpoint = 'meta';
            body = { title, keyword };
            break;
          case 'generate-faq':
            endpoint = 'faq';
            body = { title, keyword };
            break;
          case 'suggest-links':
            endpoint = 'audit';
            body = { action: 'internal-links', title, keyword };
            break;
        }

        const label = action.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
        output.show(`${label}: ${title}`);
        el.classList.add('admin-btn--loading');

        try {
          const res = await fetch(`${API_URL}/api/${endpoint}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
          });
          output.setRaw(await res.json());
        } catch {
          output.setError('Could not connect to API. Run: aileen serve');
        }
        el.classList.remove('admin-btn--loading');
      });
    });
  </script>
</Base>

<style>
  .admin-btn--loading {
    opacity: 0.5;
    pointer-events: none;
  }
</style>
