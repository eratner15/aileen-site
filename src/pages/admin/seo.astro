---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AdminActions from '../../components/AdminActions.astro';

const allPosts = await getCollection('posts');
const published = allPosts.filter(p => !p.data.draft);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// SEO health checks
const longTitle = published.filter(p => p.data.title.length > 60);
const missingMeta = published.filter(p => !p.data.metaDescription || p.data.metaDescription.length === 0 || p.data.metaDescription.length > 160);
const missingOgImage = published.filter(p => !p.data.image || p.data.image.includes('placeholder'));
const missingAlt = published.filter(p => !p.data.imageAlt || p.data.imageAlt.length === 0);
const missingKeyword = published.filter(p => !p.data.targetKeyword || p.data.targetKeyword.length === 0);
const keywordNotInTitle = published.filter(p => {
  if (!p.data.targetKeyword) return false;
  return !p.data.title.toLowerCase().includes(p.data.targetKeyword.toLowerCase());
});

// Thin content estimate (rough: body length < 4000 chars ~ 800 words)
const thinContent: typeof published = [];
for (const p of published) {
  const { body } = p;
  if (body && body.length < 4000) {
    thinContent.push(p);
  }
}

// Posts by pillar
const byPillar: Record<string, number> = {};
for (const p of published) {
  byPillar[p.data.pillar] = (byPillar[p.data.pillar] || 0) + 1;
}

// Missing destinations
const missingDestinations = published.filter(p => !p.data.destinations || p.data.destinations.length === 0);

// SEO score distribution
const withSeoScore = published.filter(p => p.data.seoScore !== undefined && p.data.seoScore !== null);
const goodSeo = withSeoScore.filter(p => p.data.seoScore! >= 75);
const warnSeo = withSeoScore.filter(p => p.data.seoScore! >= 50 && p.data.seoScore! < 75);
const badSeo = withSeoScore.filter(p => p.data.seoScore! < 50);

// Overall SEO health score
const totalChecks = published.length * 7;
const totalIssues = longTitle.length + missingMeta.length + missingOgImage.length + missingAlt.length + missingKeyword.length + keywordNotInTitle.length + thinContent.length;
const healthPercent = totalChecks > 0 ? Math.round(((totalChecks - totalIssues) / totalChecks) * 100) : 0;
---

<Base title="SEO Dashboard | Admin" noindex={true}>
  <div class="admin-layout">
    <h1>SEO Dashboard</h1>
    <p class="admin-subtitle">Search optimization health and audit</p>

    <span id="api-status" class="api-status api-status--offline">Checking API...</span>

    <div class="admin-actions-bar">
      <button class="admin-btn" data-action="audit">Run SEO Audit (All Posts)</button>
    </div>
    <pre id="action-output"></pre>

    <nav class="admin-nav">
      <a href={`${base}/admin/`} class="admin-nav-link">Editorial</a>
      <a href={`${base}/admin/posts/`} class="admin-nav-link">All Posts</a>
      <a href={`${base}/admin/calendar/`} class="admin-nav-link">Calendar</a>
      <a href={`${base}/admin/archive/`} class="admin-nav-link">Archive</a>
      <a href={`${base}/admin/seo/`} class="admin-nav-link active">SEO</a>
      <a href={`${base}/admin/opportunities/`} class="admin-nav-link">Opportunities</a>
      <a href={`${base}/admin/distribution/`} class="admin-nav-link">Distribution</a>
      <a href={`${base}/admin/monetization/`} class="admin-nav-link">Monetization</a>
      <a href={`${base}/admin/performance/`} class="admin-nav-link">Performance</a>
    </nav>

    <!-- SEO Health Scorecard -->
    <div class="admin-stats-grid">
      <div class="admin-stat">
        <span class={`admin-stat-number ${healthPercent >= 75 ? 'voice-score--good' : healthPercent >= 50 ? 'voice-score--warn' : 'voice-score--bad'}`}>{healthPercent}%</span>
        <span class="admin-stat-label">Overall SEO Health</span>
      </div>
      <div class="admin-stat">
        <span class="admin-stat-number">{published.length}</span>
        <span class="admin-stat-label">Published Posts</span>
      </div>
      <div class="admin-stat">
        <span class="admin-stat-number">{totalIssues}</span>
        <span class="admin-stat-label">Total Issues</span>
      </div>
      <div class="admin-stat">
        <span class="admin-stat-number">{withSeoScore.length}</span>
        <span class="admin-stat-label">Have SEO Score</span>
      </div>
    </div>

    <!-- SEO Issues Breakdown -->
    <div class="admin-card">
      <h2>SEO Health Scorecard</h2>
      <table class="admin-table">
        <thead>
          <tr>
            <th>Check</th>
            <th>Issues</th>
            <th>Passing</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Title length (&le; 60 chars)</td>
            <td>{longTitle.length}</td>
            <td>{published.length - longTitle.length}</td>
            <td><span class={`status-badge ${longTitle.length === 0 ? 'voice-score--good' : 'voice-score--warn'}`}>{longTitle.length === 0 ? 'Pass' : 'Issues'}</span></td>
          </tr>
          <tr>
            <td>Meta description (present, &le; 160 chars)</td>
            <td>{missingMeta.length}</td>
            <td>{published.length - missingMeta.length}</td>
            <td><span class={`status-badge ${missingMeta.length === 0 ? 'voice-score--good' : 'voice-score--warn'}`}>{missingMeta.length === 0 ? 'Pass' : 'Issues'}</span></td>
          </tr>
          <tr>
            <td>OG image (no placeholder)</td>
            <td>{missingOgImage.length}</td>
            <td>{published.length - missingOgImage.length}</td>
            <td><span class={`status-badge ${missingOgImage.length === 0 ? 'voice-score--good' : 'voice-score--bad'}`}>{missingOgImage.length === 0 ? 'Pass' : 'Issues'}</span></td>
          </tr>
          <tr>
            <td>Image alt text</td>
            <td>{missingAlt.length}</td>
            <td>{published.length - missingAlt.length}</td>
            <td><span class={`status-badge ${missingAlt.length === 0 ? 'voice-score--good' : 'voice-score--warn'}`}>{missingAlt.length === 0 ? 'Pass' : 'Issues'}</span></td>
          </tr>
          <tr>
            <td>Target keyword set</td>
            <td>{missingKeyword.length}</td>
            <td>{published.length - missingKeyword.length}</td>
            <td><span class={`status-badge ${missingKeyword.length === 0 ? 'voice-score--good' : 'voice-score--bad'}`}>{missingKeyword.length === 0 ? 'Pass' : 'Issues'}</span></td>
          </tr>
          <tr>
            <td>Keyword in title</td>
            <td>{keywordNotInTitle.length}</td>
            <td>{published.length - keywordNotInTitle.length}</td>
            <td><span class={`status-badge ${keywordNotInTitle.length === 0 ? 'voice-score--good' : 'voice-score--warn'}`}>{keywordNotInTitle.length === 0 ? 'Pass' : 'Issues'}</span></td>
          </tr>
          <tr>
            <td>Content depth (&ge; ~800 words)</td>
            <td>{thinContent.length}</td>
            <td>{published.length - thinContent.length}</td>
            <td><span class={`status-badge ${thinContent.length === 0 ? 'voice-score--good' : 'voice-score--warn'}`}>{thinContent.length === 0 ? 'Pass' : 'Issues'}</span></td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- SEO Score Distribution -->
    {withSeoScore.length > 0 && (
      <div class="admin-card">
        <h2>SEO Score Distribution</h2>
        <div class="admin-bar-chart">
          <div class="admin-bar-row">
            <span class="admin-bar-label">Good (75+)</span>
            <div class="admin-bar-track">
              <div class="admin-bar-fill voice-score--good" style={`width: ${Math.round(goodSeo.length / withSeoScore.length * 100)}%`}></div>
            </div>
            <span class="admin-bar-count">{goodSeo.length}</span>
          </div>
          <div class="admin-bar-row">
            <span class="admin-bar-label">Needs Work (50-74)</span>
            <div class="admin-bar-track">
              <div class="admin-bar-fill voice-score--warn" style={`width: ${Math.round(warnSeo.length / withSeoScore.length * 100)}%`}></div>
            </div>
            <span class="admin-bar-count">{warnSeo.length}</span>
          </div>
          <div class="admin-bar-row">
            <span class="admin-bar-label">Poor (&lt; 50)</span>
            <div class="admin-bar-track">
              <div class="admin-bar-fill voice-score--bad" style={`width: ${Math.round(badSeo.length / withSeoScore.length * 100)}%`}></div>
            </div>
            <span class="admin-bar-count">{badSeo.length}</span>
          </div>
        </div>
      </div>
    )}

    <!-- Posts by Pillar -->
    <div class="admin-card">
      <h2>Posts by Pillar</h2>
      <div class="admin-bar-chart">
        {Object.entries(byPillar).sort((a,b) => b[1] - a[1]).map(([pillar, count]) => (
          <div class="admin-bar-row">
            <span class="admin-bar-label">{pillar.charAt(0).toUpperCase() + pillar.slice(1)}</span>
            <div class="admin-bar-track">
              <div class="admin-bar-fill" style={`width: ${Math.round(count / published.length * 100)}%`}></div>
            </div>
            <span class="admin-bar-count">{count}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Title Issues -->
    {longTitle.length > 0 && (
      <div class="admin-card admin-card--alert">
        <h2>Titles Too Long ({longTitle.length})</h2>
        <table class="admin-table">
          <thead>
            <tr>
              <th>Title</th>
              <th>Length</th>
            </tr>
          </thead>
          <tbody>
            {longTitle.map(p => (
              <tr>
                <td>{p.data.title}</td>
                <td>{p.data.title.length} chars</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    <!-- Missing Target Keyword -->
    {missingKeyword.length > 0 && (
      <div class="admin-card admin-card--alert">
        <h2>Missing Target Keyword ({missingKeyword.length})</h2>
        <ul>
          {missingKeyword.map(p => <li>{p.data.title}</li>)}
        </ul>
      </div>
    )}

    <!-- Keyword Not In Title -->
    {keywordNotInTitle.length > 0 && (
      <div class="admin-card admin-card--alert">
        <h2>Keyword Not in Title ({keywordNotInTitle.length})</h2>
        <table class="admin-table">
          <thead>
            <tr>
              <th>Title</th>
              <th>Target Keyword</th>
            </tr>
          </thead>
          <tbody>
            {keywordNotInTitle.map(p => (
              <tr>
                <td>{p.data.title}</td>
                <td>{p.data.targetKeyword}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    <!-- Thin Content -->
    {thinContent.length > 0 && (
      <div class="admin-card admin-card--alert">
        <h2>Thin Content ({thinContent.length})</h2>
        <p>Posts with estimated word count below 800 words.</p>
        <ul>
          {thinContent.map(p => <li>{p.data.title}</li>)}
        </ul>
      </div>
    )}

    <!-- Missing Destinations -->
    {missingDestinations.length > 0 && (
      <div class="admin-card admin-card--alert">
        <h2>Missing Destinations ({missingDestinations.length})</h2>
        <ul>
          {missingDestinations.map(p => <li>{p.data.title}</li>)}
        </ul>
      </div>
    )}

    <!-- Posts Missing Meta Description -->
    {missingMeta.length > 0 && (
      <div class="admin-card admin-card--alert">
        <h2>Meta Description Issues ({missingMeta.length})</h2>
        <table class="admin-table">
          <thead>
            <tr>
              <th>Title</th>
              <th>Issue</th>
            </tr>
          </thead>
          <tbody>
            {missingMeta.map(p => (
              <tr>
                <td>{p.data.title}</td>
                <td>{!p.data.metaDescription ? 'Missing' : `Too long (${p.data.metaDescription.length} chars)`}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>
  <AdminActions />
</Base>
