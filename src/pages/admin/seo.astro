---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Word count estimator
function estimateWords(body: string | undefined): number {
  if (!body) return 0;
  return body.split(/\s+/).filter(w => w.length > 0).length;
}

// SEO Health Scorecard summary
const withMeta = allPosts.filter(p => p.data.metaDescription && p.data.metaDescription.length > 0);
const withKeyword = allPosts.filter(p => p.data.targetKeyword && p.data.targetKeyword.length > 0);
const withFaq = allPosts.filter(p => p.data.faq && p.data.faq.length > 0);
const wordCounts = allPosts.map(p => estimateWords(p.body));
const avgWordCount = wordCounts.length > 0 ? Math.round(wordCounts.reduce((a, b) => a + b, 0) / wordCounts.length) : 0;
const over1500 = wordCounts.filter(w => w > 1500).length;

// 7-check audit per post
interface AuditResult {
  id: string;
  title: string;
  pillar: string;
  checks: { name: string; pass: boolean }[];
  score: number;
  passed: number;
  failed: number;
}

const audits: AuditResult[] = allPosts.map(p => {
  const words = estimateWords(p.body);
  const checks = [
    { name: 'Title 50-60 chars', pass: p.data.title.length >= 50 && p.data.title.length <= 60 },
    { name: 'Meta description', pass: !!p.data.metaDescription && p.data.metaDescription.length > 0 },
    { name: 'Target keyword', pass: !!p.data.targetKeyword && p.data.targetKeyword.length > 0 },
    { name: 'Has FAQ', pass: p.data.faq && p.data.faq.length > 0 },
    { name: 'Word count > 1000', pass: words > 1000 },
    { name: 'Image alt text', pass: !!p.data.imageAlt && p.data.imageAlt.length > 0 },
    { name: 'Internal links', pass: p.data.relatedPosts && p.data.relatedPosts.length > 0 },
  ];
  const passed = checks.filter(c => c.pass).length;
  return {
    id: p.id,
    title: p.data.title,
    pillar: p.data.pillar,
    checks,
    score: Math.round((passed / checks.length) * 100),
    passed,
    failed: checks.length - passed,
  };
}).sort((a, b) => a.score - b.score); // worst first

// Missing internal links
const missingLinks = allPosts
  .filter(p => !p.data.relatedPosts || p.data.relatedPosts.length === 0)
  .map(p => ({ id: p.id, title: p.data.title }));

// Keyword gaps
const keywordGaps = allPosts
  .filter(p => !p.data.targetKeyword || p.data.targetKeyword.length === 0)
  .map(p => ({ id: p.id, title: p.data.title }));

// Overall health
const totalChecks = allPosts.length * 7;
const totalPassed = audits.reduce((s, a) => s + a.passed, 0);
const overallHealth = totalChecks > 0 ? Math.round((totalPassed / totalChecks) * 100) : 0;
---

<Base title="SEO Engine | Admin" noindex={true}>
  <div class="admin-wrap">
    <div class="admin-header">
      <h1>SEO Engine</h1>
    </div>

    <nav class="admin-nav">
      <a href={`${base}/admin/`}>Command Center</a>
      <a href={`${base}/admin/content/`}>Content</a>
      <a href={`${base}/admin/archive/`}>Evergreen</a>
      <a href={`${base}/admin/seo/`} class="active">SEO</a>
      <a href={`${base}/admin/distribution/`}>Distribution</a>
      <a href={`${base}/admin/revenue/`}>Revenue</a>
      <a href={`${base}/admin/performance/`}>Performance</a>
      <a href={`${base}/admin/ai-assist/`}>AI Assist</a>
      <a href={`${base}/admin/settings/`}>Settings</a>
    </nav>

    <!-- SEO Health Scorecard -->
    <section class="admin-section">
      <h2>SEO Health Scorecard</h2>
      <div class="stats-grid">
        <div class="stat-card">
          <div class={`stat-number ${overallHealth >= 70 ? 'good' : overallHealth >= 40 ? 'warn' : 'bad'}`}>{overallHealth}%</div>
          <div class="stat-label">Overall Health</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">{withMeta.length}/{allPosts.length}</div>
          <div class="stat-label">Have Meta</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">{withKeyword.length}/{allPosts.length}</div>
          <div class="stat-label">Have Keyword</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">{withFaq.length}/{allPosts.length}</div>
          <div class="stat-label">Have FAQ</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">{avgWordCount}</div>
          <div class="stat-label">Avg Words</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">{over1500}</div>
          <div class="stat-label">Posts > 1500w</div>
        </div>
      </div>
    </section>

    <!-- Audit Table -->
    <section class="admin-section">
      <h2>Post SEO Audit (sorted by health, worst first)</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Title</th>
              <th>SEO Score</th>
              <th>Passed</th>
              <th>Title Len</th>
              <th>Meta</th>
              <th>Keyword</th>
              <th>FAQ</th>
              <th>Words</th>
              <th>Alt</th>
              <th>Links</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {audits.map(a => (
              <tr>
                <td>{a.title}</td>
                <td><span class={`score-badge ${a.score >= 70 ? 'good' : a.score >= 40 ? 'warn' : 'bad'}`}>{a.score}%</span></td>
                <td>{a.passed}/{a.checks.length}</td>
                {a.checks.map(c => (
                  <td class={c.pass ? 'check-pass' : 'check-fail'}>{c.pass ? 'OK' : 'X'}</td>
                ))}
                <td class="actions-cell">
                  <button class="btn btn-sm api-action" data-endpoint="/api/seo-fix" data-slug={a.id}>SEO Fix</button>
                  <button class="btn btn-sm api-action" data-endpoint="/api/generate-meta" data-slug={a.id}>Meta</button>
                  <button class="btn btn-sm api-action" data-endpoint="/api/generate-faq" data-slug={a.id}>FAQ</button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="result-panel" style="display:none;"></div>
    </section>

    <!-- Missing Internal Links -->
    <section class="admin-section">
      <h2>Missing Internal Links ({missingLinks.length})</h2>
      {missingLinks.length > 0 ? (
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Title</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              {missingLinks.map(p => (
                <tr>
                  <td>{p.title}</td>
                  <td>
                    <button class="btn btn-sm api-action" data-endpoint="/api/suggest-links" data-slug={p.id}>Suggest Links</button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="empty-state">All posts have internal links.</p>
      )}
      <div class="result-panel" style="display:none;"></div>
    </section>

    <!-- Keyword Gaps -->
    <section class="admin-section">
      <h2>Keyword Gaps ({keywordGaps.length})</h2>
      {keywordGaps.length > 0 ? (
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Title</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              {keywordGaps.map(p => (
                <tr>
                  <td>{p.title}</td>
                  <td>
                    <button class="btn btn-sm api-action" data-endpoint="/api/generate-keyword" data-slug={p.id}>Generate Keyword</button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="empty-state">All posts have target keywords.</p>
      )}
      <div class="result-panel" style="display:none;"></div>
    </section>

    <!-- Bulk Actions -->
    <section class="admin-section">
      <h2>Bulk Actions</h2>
      <div class="quick-actions">
        <button class="btn btn-primary api-action" data-endpoint="/api/audit">Run Full SEO Audit</button>
        <button class="btn btn-primary api-action" data-endpoint="/api/seo-fix">Generate Titles (All)</button>
        <button class="btn btn-primary api-action" data-endpoint="/api/generate-meta">Generate Meta (All)</button>
        <button class="btn btn-secondary api-action" data-endpoint="/api/generate-faq">Add FAQ (All)</button>
      </div>
      <div class="result-panel" style="display:none;"></div>
    </section>
  </div>
</Base>

<style>
  .admin-wrap { max-width: 1400px; margin: 0 auto; padding: 2rem 1.5rem; font-family: 'Inter', -apple-system, sans-serif; }
  .admin-header { margin-bottom: 1rem; border-bottom: 3px solid #000; padding-bottom: 1rem; }
  .admin-header h1 { font-family: 'Playfair Display', Georgia, serif; font-size: 2rem; margin: 0; }
  .admin-nav { display: flex; flex-wrap: wrap; gap: 0.25rem; margin-bottom: 2rem; border-bottom: 1px solid #e8e8e8; padding-bottom: 0.75rem; }
  .admin-nav a { padding: 0.4rem 0.75rem; text-decoration: none; color: #666; font-size: 0.85rem; border-radius: 4px; transition: all 0.15s; }
  .admin-nav a:hover { background: #f5f5f5; color: #000; }
  .admin-nav a.active { background: #000; color: #fff; }
  .admin-section { margin-bottom: 2.5rem; }
  .admin-section h2 { font-family: 'Playfair Display', Georgia, serif; font-size: 1.3rem; margin: 0 0 1rem; border-bottom: 1px solid #e8e8e8; padding-bottom: 0.5rem; }
  .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 1rem; }
  .stat-card { background: #f5f5f5; padding: 1rem; text-align: center; border: 1px solid #e8e8e8; }
  .stat-number { font-size: 1.5rem; font-weight: 700; color: #000; }
  .stat-number.good { color: #22c55e; }
  .stat-number.warn { color: #f59e0b; }
  .stat-number.bad { color: #ef4444; }
  .stat-label { font-size: 0.7rem; color: #666; text-transform: uppercase; letter-spacing: 0.05em; }
  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 0.8rem; }
  th, td { text-align: left; padding: 0.4rem 0.5rem; border-bottom: 1px solid #e8e8e8; }
  th { font-weight: 600; text-transform: uppercase; font-size: 0.6rem; letter-spacing: 0.05em; color: #666; background: #f5f5f5; white-space: nowrap; }
  .check-pass { color: #22c55e; font-weight: 700; text-align: center; }
  .check-fail { color: #ef4444; font-weight: 700; text-align: center; }
  .score-badge { font-size: 0.75rem; padding: 0.15rem 0.4rem; font-weight: 700; }
  .score-badge.good { background: #f0fdf4; color: #22c55e; }
  .score-badge.warn { background: #fffbeb; color: #f59e0b; }
  .score-badge.bad { background: #fef2f2; color: #ef4444; }
  .actions-cell { white-space: nowrap; }
  .btn { padding: 0.4rem 0.75rem; border: 1px solid #000; cursor: pointer; font-size: 0.75rem; font-family: inherit; transition: all 0.15s; text-decoration: none; display: inline-block; background: #fff; color: #000; }
  .btn-primary { background: #000; color: #fff; }
  .btn-primary:hover { background: #333; }
  .btn-secondary { background: #fff; color: #000; }
  .btn-sm { padding: 0.2rem 0.4rem; font-size: 0.65rem; }
  .btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .quick-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .result-panel { margin-top: 1rem; padding: 1rem; background: #f5f5f5; border: 1px solid #e8e8e8; font-size: 0.85rem; white-space: pre-wrap; max-height: 400px; overflow-y: auto; font-family: monospace; }
  .empty-state { color: #999; font-style: italic; font-size: 0.9rem; }
</style>

<script>
  const API_BASE = 'http://localhost:3001';

  async function apiCall(endpoint: string, method = 'POST', body?: object) {
    try {
      const res = await fetch(`${API_BASE}${endpoint}`, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: body ? JSON.stringify(body) : undefined,
      });
      if (!res.ok) throw new Error(`API error: ${res.status}`);
      return await res.json();
    } catch (e: any) {
      return { error: true, message: e.message || 'API unavailable. Is the growth engine running on localhost:3001?' };
    }
  }

  document.querySelectorAll('.api-action').forEach(btn => {
    btn.addEventListener('click', async () => {
      const endpoint = (btn as HTMLElement).dataset.endpoint!;
      const slug = (btn as HTMLElement).dataset.slug;
      const origText = btn.textContent;
      btn.textContent = 'Working...';
      (btn as HTMLButtonElement).disabled = true;
      const result = await apiCall(endpoint, 'POST', slug ? { slug } : undefined);
      const panel = btn.closest('.admin-section')?.querySelector('.result-panel');
      if (panel) {
        (panel as HTMLElement).style.display = 'block';
        (panel as HTMLElement).textContent = JSON.stringify(result, null, 2);
      }
      btn.textContent = origText;
      (btn as HTMLButtonElement).disabled = false;
    });
  });
</script>
