---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Stats
const totalPosts = allPosts.length;
const classified = allPosts.filter(p => p.data.status !== 'imported').length;
const unclassified = allPosts.filter(p => p.data.status === 'imported').length;
const needsRefresh = allPosts.filter(p => ['high', 'medium'].includes(p.data.refreshPriority)).length;
const unmonetized = allPosts.filter(p => p.data.monetizationPotential === 'high' && p.data.products.length === 0).length;
const undistributed = allPosts.filter(p => p.data.pinsGenerated === 0 && p.data.evergreenScore > 50).length;
const missingSEO = allPosts.filter(p => !p.data.metaDescription || !p.data.targetKeyword).length;

// Stale content (older than 6 months, no refreshedDate)
const sixMonthsAgo = new Date();
sixMonthsAgo.setMonth(sixMonthsAgo.getMonth() - 6);
const stalePosts = allPosts
  .filter(p => {
    const postDate = new Date(p.data.date);
    return postDate < sixMonthsAgo && !p.data.refreshedDate;
  })
  .sort((a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime());

// Highest-leverage actions
const actions: Array<{ label: string; description: string; count: number; endpoint: string; priority: number }> = [];

if (unclassified > 0) {
  actions.push({ label: 'Run Classification', description: `${unclassified} unclassified posts need scoring`, count: unclassified, endpoint: '/api/classify', priority: unclassified });
}
if (needsRefresh > 0) {
  actions.push({ label: 'Generate Refresh Brief', description: `${needsRefresh} posts need content refresh`, count: needsRefresh, endpoint: '/api/refresh-brief', priority: needsRefresh });
}
if (unmonetized > 0) {
  actions.push({ label: 'Add Affiliate Block', description: `${unmonetized} high-potential posts have no products`, count: unmonetized, endpoint: '/api/affiliate-suggest', priority: unmonetized });
}
if (undistributed > 0) {
  actions.push({ label: 'Generate Pins', description: `${undistributed} evergreen posts have no pins`, count: undistributed, endpoint: '/api/pins', priority: undistributed });
}
if (missingSEO > 0) {
  actions.push({ label: 'Enrich Metadata', description: `${missingSEO} posts missing meta description or keyword`, count: missingSEO, endpoint: '/api/enrich', priority: missingSEO });
}

const topActions = actions.sort((a, b) => b.priority - a.priority).slice(0, 5);
---

<Base title="EVAN OS -- Command Center" noindex={true}>
  <div class="admin-wrap">
    <div class="admin-header">
      <h1>EVAN OS -- Command Center</h1>
      <div class="api-status" id="api-status">
        <span class="status-dot offline"></span>
        <span class="status-text">Checking API...</span>
      </div>
    </div>

    <nav class="admin-nav">
      <a href={`${base}/admin/`} class="active">Command Center</a>
      <a href={`${base}/admin/content/`}>Content</a>
      <a href={`${base}/admin/archive/`}>Evergreen</a>
      <a href={`${base}/admin/seo/`}>SEO</a>
      <a href={`${base}/admin/distribution/`}>Distribution</a>
      <a href={`${base}/admin/revenue/`}>Revenue</a>
      <a href={`${base}/admin/performance/`}>Performance</a>
      <a href={`${base}/admin/ai-assist/`}>AI Assist</a>
      <a href={`${base}/admin/settings/`}>Settings</a>
    </nav>

    <!-- What Should Evan Do Next? -->
    <section class="admin-section">
      <h2>What Should Evan Do Next?</h2>
      {topActions.length > 0 ? (
        <div class="action-cards">
          {topActions.map((action, i) => (
            <div class="action-card" data-priority={i + 1}>
              <div class="action-rank">#{i + 1}</div>
              <div class="action-info">
                <h3>{action.label}</h3>
                <p>{action.description}</p>
              </div>
              <button class="btn btn-primary api-action" data-endpoint={action.endpoint}>
                Run
              </button>
            </div>
          ))}
        </div>
      ) : (
        <p class="empty-state">All caught up. No high-priority actions right now.</p>
      )}
      <div id="action-result" class="result-panel" style="display:none;"></div>
    </section>

    <!-- Stats Grid -->
    <section class="admin-section">
      <h2>Overview</h2>
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-number">{totalPosts}</div>
          <div class="stat-label">Total Posts</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">{classified}</div>
          <div class="stat-label">Classified</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">{needsRefresh}</div>
          <div class="stat-label">Needs Refresh</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">{unmonetized}</div>
          <div class="stat-label">Unmonetized</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">{undistributed}</div>
          <div class="stat-label">Undistributed</div>
        </div>
        <div class="stat-card">
          <div class="stat-number">{missingSEO}</div>
          <div class="stat-label">Missing SEO</div>
        </div>
      </div>
    </section>

    <!-- Stale Content -->
    <section class="admin-section">
      <h2>Stale Content ({stalePosts.length} posts older than 6 months, never refreshed)</h2>
      {stalePosts.length > 0 ? (
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Title</th>
                <th>Pillar</th>
                <th>Date</th>
                <th>Evergreen</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              {stalePosts.slice(0, 20).map(post => {
                const [pillar, ...rest] = post.id.split('/');
                const slug = rest.join('/');
                return (
                  <tr>
                    <td><a href={`${base}/${pillar}/${slug}/`} target="_blank">{post.data.title}</a></td>
                    <td>{post.data.pillar}</td>
                    <td>{post.data.date}</td>
                    <td>{post.data.evergreenScore}</td>
                    <td><span class={`badge badge-${post.data.status}`}>{post.data.status}</span></td>
                    <td>
                      <button class="btn btn-sm api-action" data-endpoint="/api/refresh-brief" data-slug={post.id}>Refresh Brief</button>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
          {stalePosts.length > 20 && <p class="table-more">...and {stalePosts.length - 20} more</p>}
        </div>
      ) : (
        <p class="empty-state">No stale content found.</p>
      )}
      <div class="result-panel" style="display:none;"></div>
    </section>

    <!-- Quick Actions -->
    <section class="admin-section">
      <h2>Quick Actions</h2>
      <div class="quick-actions">
        <button class="btn btn-primary api-action" data-endpoint="/api/classify">Classify All</button>
        <button class="btn btn-primary api-action" data-endpoint="/api/enrich">Enrich All</button>
        <button class="btn btn-primary api-action" data-endpoint="/api/plan">Generate Plan</button>
        <button class="btn btn-primary api-action" data-endpoint="/api/import">Import Posts</button>
        <button class="btn btn-secondary api-action" data-endpoint="/api/deploy">Build &amp; Deploy</button>
      </div>
      <div class="result-panel" style="display:none;"></div>
    </section>
  </div>
</Base>

<style>
  .admin-wrap { max-width: 1200px; margin: 0 auto; padding: 2rem 1.5rem; font-family: 'Inter', -apple-system, sans-serif; }
  .admin-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; border-bottom: 3px solid #000; padding-bottom: 1rem; }
  .admin-header h1 { font-family: 'Playfair Display', Georgia, serif; font-size: 2rem; margin: 0; }
  .api-status { display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; }
  .status-dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
  .status-dot.online { background: #22c55e; }
  .status-dot.offline { background: #ef4444; }
  .status-dot.checking { background: #f59e0b; }
  .admin-nav { display: flex; flex-wrap: wrap; gap: 0.25rem; margin-bottom: 2rem; border-bottom: 1px solid #e8e8e8; padding-bottom: 0.75rem; }
  .admin-nav a { padding: 0.4rem 0.75rem; text-decoration: none; color: #666; font-size: 0.85rem; border-radius: 4px; transition: all 0.15s; }
  .admin-nav a:hover { background: #f5f5f5; color: #000; }
  .admin-nav a.active { background: #000; color: #fff; }
  .admin-section { margin-bottom: 2.5rem; }
  .admin-section h2 { font-family: 'Playfair Display', Georgia, serif; font-size: 1.3rem; margin: 0 0 1rem; border-bottom: 1px solid #e8e8e8; padding-bottom: 0.5rem; }
  .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem; }
  .stat-card { background: #f5f5f5; padding: 1.25rem; text-align: center; border: 1px solid #e8e8e8; }
  .stat-number { font-size: 2rem; font-weight: 700; color: #000; }
  .stat-label { font-size: 0.8rem; color: #666; text-transform: uppercase; letter-spacing: 0.05em; margin-top: 0.25rem; }
  .action-cards { display: flex; flex-direction: column; gap: 0.75rem; }
  .action-card { display: flex; align-items: center; gap: 1rem; padding: 1rem; background: #f5f5f5; border: 1px solid #e8e8e8; }
  .action-rank { font-size: 1.5rem; font-weight: 700; color: #999; min-width: 2.5rem; text-align: center; }
  .action-info { flex: 1; }
  .action-info h3 { margin: 0; font-size: 1rem; }
  .action-info p { margin: 0.25rem 0 0; font-size: 0.85rem; color: #666; }
  .btn { padding: 0.5rem 1rem; border: 1px solid #000; cursor: pointer; font-size: 0.8rem; font-family: inherit; transition: all 0.15s; text-decoration: none; display: inline-block; }
  .btn-primary { background: #000; color: #fff; }
  .btn-primary:hover { background: #333; }
  .btn-secondary { background: #fff; color: #000; }
  .btn-secondary:hover { background: #f5f5f5; }
  .btn-sm { padding: 0.25rem 0.5rem; font-size: 0.75rem; }
  .btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .quick-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
  th, td { text-align: left; padding: 0.6rem 0.75rem; border-bottom: 1px solid #e8e8e8; }
  th { font-weight: 600; text-transform: uppercase; font-size: 0.7rem; letter-spacing: 0.05em; color: #666; background: #f5f5f5; }
  td a { color: #000; }
  .badge { font-size: 0.7rem; padding: 0.15rem 0.4rem; text-transform: uppercase; letter-spacing: 0.03em; }
  .badge-imported { background: #e8e8e8; color: #666; }
  .badge-classified { background: #000; color: #fff; }
  .badge-refreshed { background: #333; color: #fff; }
  .badge-redistributed { background: #666; color: #fff; }
  .badge-monetized { background: #999; color: #fff; }
  .result-panel { margin-top: 1rem; padding: 1rem; background: #f5f5f5; border: 1px solid #e8e8e8; font-size: 0.85rem; white-space: pre-wrap; max-height: 400px; overflow-y: auto; font-family: monospace; }
  .empty-state { color: #999; font-style: italic; font-size: 0.9rem; }
  .table-more { font-size: 0.85rem; color: #666; margin-top: 0.5rem; }
</style>

<script>
  const API_BASE = 'http://localhost:3001';

  async function apiCall(endpoint: string, method = 'POST', body?: object) {
    try {
      const res = await fetch(`${API_BASE}${endpoint}`, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: body ? JSON.stringify(body) : undefined,
      });
      if (!res.ok) throw new Error(`API error: ${res.status}`);
      return await res.json();
    } catch (e: any) {
      return { error: true, message: e.message || 'API unavailable. Is the growth engine running on localhost:3001?' };
    }
  }

  // Check API health
  (async () => {
    const dot = document.querySelector('.status-dot')!;
    const text = document.querySelector('.status-text')!;
    dot.classList.remove('offline');
    dot.classList.add('checking');
    try {
      const res = await fetch(`${API_BASE}/api/health`, { method: 'GET' });
      if (res.ok) {
        dot.classList.remove('checking');
        dot.classList.add('online');
        text.textContent = 'API Online';
      } else { throw new Error(); }
    } catch {
      dot.classList.remove('checking');
      dot.classList.add('offline');
      text.textContent = 'API Offline';
    }
  })();

  // Wire up action buttons
  document.querySelectorAll('.api-action').forEach(btn => {
    btn.addEventListener('click', async () => {
      const endpoint = (btn as HTMLElement).dataset.endpoint!;
      const slug = (btn as HTMLElement).dataset.slug;
      const origText = btn.textContent;
      btn.textContent = 'Working...';
      (btn as HTMLButtonElement).disabled = true;
      const result = await apiCall(endpoint, 'POST', slug ? { slug } : undefined);
      const panel = btn.closest('.admin-section')?.querySelector('.result-panel') ||
                    document.getElementById('action-result');
      if (panel) {
        (panel as HTMLElement).style.display = 'block';
        (panel as HTMLElement).textContent = JSON.stringify(result, null, 2);
      }
      btn.textContent = origText;
      (btn as HTMLButtonElement).disabled = false;
    });
  });
</script>
