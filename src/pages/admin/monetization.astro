---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AdminNav from '../../components/AdminNav.astro';
import AdminOutput from '../../components/AdminOutput.astro';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Monetization analysis per post
const monetizationData = allPosts.map(post => {
  const hasProducts = post.data.products.length > 0;
  const hasBooking = post.data.bookingLinks.length > 0;
  const hasReservation = post.data.reservationLinks.length > 0;
  const hasDisclosure = post.data.affiliateDisclosure || post.data.disclosureAdded;
  const isMonetizable = ['restaurant-guide', 'hotel-review', 'the-edit', 'style-guide', 'travel-guide'].includes(post.data.contentType || '');
  const isMonetized = hasProducts || hasBooking || hasReservation;
  const needsDisclosure = isMonetized && !hasDisclosure;

  return {
    post,
    hasProducts,
    hasBooking,
    hasReservation,
    hasDisclosure,
    isMonetizable,
    isMonetized,
    needsDisclosure,
  };
});

const monetized = monetizationData.filter(m => m.isMonetized);
const unmonetizedOpps = monetizationData.filter(m => m.isMonetizable && !m.isMonetized);
const missingDisclosure = monetizationData.filter(m => m.needsDisclosure);
const theEditPotential = monetizationData.filter(m => m.hasProducts && m.post.data.contentType !== 'the-edit');

function postUrl(post: typeof allPosts[0]) {
  const [pillar, ...rest] = post.id.split('/');
  return `${base}/${pillar}/${rest.join('/')}/`;
}
---

<Base title="Monetization | Admin" noindex={true} isAdmin={true}>
  <div class="admin-layout">
    <h1>Monetization Console</h1>
    <p class="admin-subtitle">Revenue modules. Affiliate coverage. Disclosure tracking.</p>

    <AdminNav active="monetization" />

    <div class="admin-stats-grid">
      <div class="admin-stat">
        <span class="admin-stat-number">{monetized.length}</span>
        <span class="admin-stat-label">Monetized</span>
      </div>
      <div class="admin-stat">
        <span class="admin-stat-number">{unmonetizedOpps.length}</span>
        <span class="admin-stat-label">Opportunities</span>
      </div>
      <div class="admin-stat">
        <span class="admin-stat-number">{missingDisclosure.length}</span>
        <span class="admin-stat-label">Missing Disclosure</span>
      </div>
      <div class="admin-stat">
        <span class="admin-stat-number">{theEditPotential.length}</span>
        <span class="admin-stat-label">The Edit Potential</span>
      </div>
    </div>

    <!-- Unmonetized opportunities -->
    {unmonetizedOpps.length > 0 && (
      <div class="admin-card" style="border-left: 3px solid var(--color-warning);">
        <h2>Unmonetized Opportunities</h2>
        <p style="font-family: var(--font-ui); font-size: 0.82rem; color: var(--color-text-muted); margin-bottom: 1rem;">
          Monetizable content types with no product, booking, or reservation blocks.
        </p>
        <div class="priority-list">
          {unmonetizedOpps.map(m => {
            const typeLabel = (m.post.data.contentType || 'article').replace(/-/g, ' ');
            const suggestedAction = m.post.data.contentType === 'hotel-review' ? 'Add Booking CTA' :
              m.post.data.contentType === 'restaurant-guide' ? 'Add Reservation CTA' : 'Add Product Grid';
            return (
              <div class="priority-item">
                <div class="priority-item-signal">
                  <h4>{m.post.data.title}</h4>
                  <p>{typeLabel} — {m.post.data.destinations?.join(', ') || 'no destination'}</p>
                </div>
                <div class="priority-item-actions">
                  <button class="admin-btn admin-btn--small" data-api-action="audit-monetization" data-title={m.post.data.title} data-keyword={m.post.data.targetKeyword}>{suggestedAction}</button>
                  <a href={`${base}/admin/post/${m.post.id}/`} class="admin-btn admin-btn--small" style="text-decoration:none;">Edit</a>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    )}

    <!-- Missing disclosure -->
    {missingDisclosure.length > 0 && (
      <div class="admin-card admin-card--alert">
        <h2>Missing Disclosure ({missingDisclosure.length})</h2>
        <p style="font-family: var(--font-ui); font-size: 0.82rem; color: var(--color-text-muted); margin-bottom: 0.75rem;">
          Posts with monetization modules but no affiliate disclosure. FTC compliance risk.
        </p>
        <ul style="list-style: disc; padding-left: 1.25rem;">
          {missingDisclosure.map(m => (
            <li style="font-family: var(--font-ui); font-size: 0.82rem; margin-bottom: 0.35rem;">
              {m.post.data.title}
            </li>
          ))}
        </ul>
      </div>
    )}

    <!-- Monetization coverage -->
    <div class="admin-card">
      <h2>Full Coverage</h2>
      <table class="admin-table">
        <thead>
          <tr>
            <th>Post</th>
            <th>Type</th>
            <th>Products</th>
            <th>Booking</th>
            <th>Reservation</th>
            <th>Disclosure</th>
          </tr>
        </thead>
        <tbody>
          {monetizationData.map(m => {
            const check = (done: boolean) => done ? 'Yes' : '—';
            return (
              <tr>
                <td><a href={postUrl(m.post)} style="text-decoration:none; border-bottom: 1px solid var(--color-border);">{m.post.data.title}</a></td>
                <td>{(m.post.data.contentType || 'article').replace(/-/g, ' ')}</td>
                <td style={m.hasProducts ? 'color: var(--color-success)' : 'color: var(--color-text-muted)'}>{m.hasProducts ? m.post.data.products.length : '—'}</td>
                <td style={m.hasBooking ? 'color: var(--color-success)' : 'color: var(--color-text-muted)'}>{check(m.hasBooking)}</td>
                <td style={m.hasReservation ? 'color: var(--color-success)' : 'color: var(--color-text-muted)'}>{check(m.hasReservation)}</td>
                <td style={m.hasDisclosure ? 'color: var(--color-success)' : m.isMonetized ? 'color: var(--color-error)' : 'color: var(--color-text-muted)'}>{m.isMonetized ? (m.hasDisclosure ? 'Yes' : 'MISSING') : 'N/A'}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </div>

  <AdminOutput />

  <script>
    const API_URL = localStorage.getItem('aileen_api_url') || 'http://localhost:3001';
    const output = (window as any).adminOutput;

    document.querySelectorAll('[data-api-action]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const el = btn as HTMLElement;
        const action = el.dataset.apiAction!;
        const title = el.dataset.title || '';
        const keyword = el.dataset.keyword || '';

        output.show(`Monetization Audit: ${title}`);
        el.classList.add('admin-btn--loading');

        try {
          const res = await fetch(`${API_URL}/api/${action}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ content: `Title: ${title}\nKeyword: ${keyword}`, keyword }),
          });
          output.setRaw(await res.json());
        } catch {
          output.setError('Could not connect to API. Run: aileen serve');
        }
        el.classList.remove('admin-btn--loading');
      });
    });
  </script>
</Base>

<style>
  .admin-btn--loading {
    opacity: 0.5;
    pointer-events: none;
  }
</style>
