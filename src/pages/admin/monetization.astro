---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AdminActions from '../../components/AdminActions.astro';

const allPosts = await getCollection('posts');
const published = allPosts.filter(p => !p.data.draft);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Sort by date descending
published.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

// Monetization fields
const withAffiliateDisclosure = published.filter(p => p.data.affiliateDisclosure);
const withProducts = published.filter(p => p.data.products && p.data.products.length > 0);
const withBookingLinks = published.filter(p => p.data.bookingLinks && p.data.bookingLinks.length > 0);
const withReservationLinks = published.filter(p => p.data.reservationLinks && p.data.reservationLinks.length > 0);

// Any monetization
const monetized = published.filter(p =>
  p.data.affiliateDisclosure ||
  (p.data.products && p.data.products.length > 0) ||
  (p.data.bookingLinks && p.data.bookingLinks.length > 0) ||
  (p.data.reservationLinks && p.data.reservationLinks.length > 0)
);

// Monetizable content types that should have monetization fields
const monetizableTypes = ['restaurant-guide', 'hotel-review', 'style-guide', 'the-edit'];
const monetizablePosts = published.filter(p => monetizableTypes.includes(p.data.contentType || ''));
const missingMonetization = monetizablePosts.filter(p =>
  !p.data.affiliateDisclosure &&
  (!p.data.products || p.data.products.length === 0) &&
  (!p.data.bookingLinks || p.data.bookingLinks.length === 0) &&
  (!p.data.reservationLinks || p.data.reservationLinks.length === 0)
);

// Total product count
const totalProducts = published.reduce((sum, p) => sum + (p.data.products?.length || 0), 0);
const totalBookingLinks = published.reduce((sum, p) => sum + (p.data.bookingLinks?.length || 0), 0);
const totalReservationLinks = published.reduce((sum, p) => sum + (p.data.reservationLinks?.length || 0), 0);

// Monetization readiness
const readinessChecks = [
  { label: 'Affiliate disclosure on monetized posts', pass: monetized.every(p => p.data.affiliateDisclosure), detail: `${withAffiliateDisclosure.length} of ${monetized.length} monetized posts` },
  { label: 'Products listed on style guides / the-edit', pass: published.filter(p => ['style-guide', 'the-edit'].includes(p.data.contentType || '')).every(p => p.data.products && p.data.products.length > 0), detail: 'All style/edit posts have products' },
  { label: 'Booking links on hotel reviews', pass: published.filter(p => p.data.contentType === 'hotel-review').every(p => p.data.bookingLinks && p.data.bookingLinks.length > 0), detail: 'All hotel reviews have booking links' },
  { label: 'Reservation links on restaurant guides', pass: published.filter(p => p.data.contentType === 'restaurant-guide').every(p => p.data.reservationLinks && p.data.reservationLinks.length > 0), detail: 'All restaurant guides have reservation links' },
  { label: 'At least 10 monetized posts', pass: monetized.length >= 10, detail: `${monetized.length} monetized posts` },
  { label: 'At least 25 total product links', pass: totalProducts >= 25, detail: `${totalProducts} product links` },
];
---

<Base title="Monetization Dashboard | Admin" noindex={true}>
  <div class="admin-layout">
    <h1>Monetization Dashboard</h1>
    <p class="admin-subtitle">Revenue opportunities and affiliate tracking</p>

    <span id="api-status" class="api-status api-status--offline">Checking API...</span>

    <nav class="admin-nav">
      <a href={`${base}/admin/`} class="admin-nav-link">Editorial</a>
      <a href={`${base}/admin/posts/`} class="admin-nav-link">All Posts</a>
      <a href={`${base}/admin/calendar/`} class="admin-nav-link">Calendar</a>
      <a href={`${base}/admin/archive/`} class="admin-nav-link">Archive</a>
      <a href={`${base}/admin/seo/`} class="admin-nav-link">SEO</a>
      <a href={`${base}/admin/opportunities/`} class="admin-nav-link">Opportunities</a>
      <a href={`${base}/admin/distribution/`} class="admin-nav-link">Distribution</a>
      <a href={`${base}/admin/monetization/`} class="admin-nav-link active">Monetization</a>
      <a href={`${base}/admin/performance/`} class="admin-nav-link">Performance</a>
    </nav>

    <!-- Stats row -->
    <div class="admin-stats-grid">
      <div class="admin-stat">
        <span class="admin-stat-number">{monetized.length}</span>
        <span class="admin-stat-label">Monetized Posts</span>
      </div>
      <div class="admin-stat">
        <span class="admin-stat-number">{totalProducts}</span>
        <span class="admin-stat-label">Product Links</span>
      </div>
      <div class="admin-stat">
        <span class="admin-stat-number">{totalBookingLinks}</span>
        <span class="admin-stat-label">Booking Links</span>
      </div>
      <div class="admin-stat">
        <span class="admin-stat-number">{totalReservationLinks}</span>
        <span class="admin-stat-label">Reservation Links</span>
      </div>
    </div>

    <!-- Monetization by Channel -->
    <div class="admin-card">
      <h2>Monetization by Channel</h2>
      <div class="admin-bar-chart">
        <div class="admin-bar-row">
          <span class="admin-bar-label">Affiliate Disclosure</span>
          <div class="admin-bar-track">
            <div class="admin-bar-fill" style={`width: ${published.length > 0 ? Math.round(withAffiliateDisclosure.length / published.length * 100) : 0}%`}></div>
          </div>
          <span class="admin-bar-count">{withAffiliateDisclosure.length}</span>
        </div>
        <div class="admin-bar-row">
          <span class="admin-bar-label">Products</span>
          <div class="admin-bar-track">
            <div class="admin-bar-fill" style={`width: ${published.length > 0 ? Math.round(withProducts.length / published.length * 100) : 0}%`}></div>
          </div>
          <span class="admin-bar-count">{withProducts.length}</span>
        </div>
        <div class="admin-bar-row">
          <span class="admin-bar-label">Booking Links</span>
          <div class="admin-bar-track">
            <div class="admin-bar-fill" style={`width: ${published.length > 0 ? Math.round(withBookingLinks.length / published.length * 100) : 0}%`}></div>
          </div>
          <span class="admin-bar-count">{withBookingLinks.length}</span>
        </div>
        <div class="admin-bar-row">
          <span class="admin-bar-label">Reservation Links</span>
          <div class="admin-bar-track">
            <div class="admin-bar-fill" style={`width: ${published.length > 0 ? Math.round(withReservationLinks.length / published.length * 100) : 0}%`}></div>
          </div>
          <span class="admin-bar-count">{withReservationLinks.length}</span>
        </div>
      </div>
    </div>

    <!-- Monetization Readiness Checklist -->
    <div class="admin-card">
      <h2>Monetization Readiness Checklist</h2>
      <table class="admin-table">
        <thead>
          <tr>
            <th>Check</th>
            <th>Detail</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          {readinessChecks.map(check => (
            <tr>
              <td>{check.label}</td>
              <td>{check.detail}</td>
              <td>
                <span class={`status-badge ${check.pass ? 'voice-score--good' : 'voice-score--bad'}`}>
                  {check.pass ? 'Pass' : 'Needs Work'}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Missing Monetization on Monetizable Posts -->
    {missingMonetization.length > 0 && (
      <div class="admin-card admin-card--alert">
        <h2>Monetizable Posts Missing Revenue Links ({missingMonetization.length})</h2>
        <p>These posts are monetizable content types ({monetizableTypes.join(', ').replace(/-/g, ' ')}) but have no products, booking links, or reservation links.</p>
        <table class="admin-table">
          <thead>
            <tr>
              <th>Title</th>
              <th>Type</th>
              <th>Pillar</th>
              <th>Published</th>
            </tr>
          </thead>
          <tbody>
            {missingMonetization.map(p => (
              <tr>
                <td>{p.data.title}</td>
                <td><span class="status-badge">{(p.data.contentType || 'article').replace(/-/g, ' ')}</span></td>
                <td>{p.data.pillar}</td>
                <td>{p.data.date}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    <!-- Monetized Posts Detail -->
    <div class="admin-card">
      <h2>Monetized Posts Detail</h2>
      <table class="admin-table">
        <thead>
          <tr>
            <th>Title</th>
            <th>Type</th>
            <th>Disclosure</th>
            <th>Products</th>
            <th>Booking</th>
            <th>Reservation</th>
          </tr>
        </thead>
        <tbody>
          {monetized.map(p => (
            <tr>
              <td>{p.data.title}</td>
              <td><span class="status-badge">{(p.data.contentType || 'article').replace(/-/g, ' ')}</span></td>
              <td>
                <span class={`status-badge ${p.data.affiliateDisclosure ? 'voice-score--good' : 'voice-score--bad'}`}>
                  {p.data.affiliateDisclosure ? 'Yes' : 'No'}
                </span>
              </td>
              <td>{p.data.products?.length || 0}</td>
              <td>{p.data.bookingLinks?.length || 0}</td>
              <td>{p.data.reservationLinks?.length || 0}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
  <AdminActions />
</Base>
