---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AdminActions from '../../components/AdminActions.astro';

const allPosts = await getCollection('posts');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Group posts by date
const postsByDate: Record<string, typeof allPosts> = {};
for (const p of allPosts) {
  const date = p.data.date;
  if (!postsByDate[date]) postsByDate[date] = [];
  postsByDate[date].push(p);
}

const today = new Date();

function formatDate(year: number, month: number, day: number) {
  return `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
}

const todayStr = formatDate(today.getFullYear(), today.getMonth(), today.getDate());

// Pre-compute calendar data for 6 months
type CalCell = { day: number | null; dateStr: string; isToday: boolean; posts: typeof allPosts };
type CalMonth = { label: string; cells: CalCell[] };

const calMonths: CalMonth[] = [];
for (let i = -2; i <= 3; i++) {
  const d = new Date(today.getFullYear(), today.getMonth() + i, 1);
  const year = d.getFullYear();
  const month = d.getMonth();
  const label = d.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
  const daysInMonth = new Date(year, month + 1, 0).getDate();
  const firstDay = new Date(year, month, 1).getDay();

  const cells: CalCell[] = [];

  // Empty cells before first day
  for (let e = 0; e < firstDay; e++) {
    cells.push({ day: null, dateStr: '', isToday: false, posts: [] });
  }

  // Day cells
  for (let day = 1; day <= daysInMonth; day++) {
    const dateStr = formatDate(year, month, day);
    cells.push({
      day,
      dateStr,
      isToday: dateStr === todayStr,
      posts: postsByDate[dateStr] || [],
    });
  }

  // Pad to complete last week
  while (cells.length % 7 !== 0) {
    cells.push({ day: null, dateStr: '', isToday: false, posts: [] });
  }

  calMonths.push({ label, cells });
}

// Publishing velocity
const published = allPosts.filter(p => !p.data.draft);
const thisMonth = published.filter(p => {
  const d = new Date(p.data.date);
  return d.getMonth() === today.getMonth() && d.getFullYear() === today.getFullYear();
});
const lastMonth = published.filter(p => {
  const d = new Date(p.data.date);
  const lm = new Date(today.getFullYear(), today.getMonth() - 1, 1);
  return d.getMonth() === lm.getMonth() && d.getFullYear() === lm.getFullYear();
});

const pillarColors: Record<string, string> = {
  business: '#1565c0',
  culture: '#9c27b0',
  finance: '#2e7d32',
  tech: '#e65100',
  travel: '#0097a7',
  lifestyle: '#5d4037',
  food: '#ef6c00',
  entertainment: '#c62828',
};

// Pre-compute roadmap data
type RoadmapRow = { label: string; target: number; actual: number; cumulative: number; cumulativeTarget: number; isPast: boolean; isCurrent: boolean };
const roadmapRows: RoadmapRow[] = [];
for (let offset = 0; offset < 6; offset++) {
  const m = new Date(2026, 2 + offset, 1);
  const monthLabel = m.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
  const monthPosts = published.filter(p => {
    const d = new Date(p.data.date);
    return d.getMonth() === m.getMonth() && d.getFullYear() === m.getFullYear();
  });
  const cumulative = published.filter(p => new Date(p.data.date) <= new Date(m.getFullYear(), m.getMonth() + 1, 0)).length;
  const isPast = m < new Date(today.getFullYear(), today.getMonth(), 1);
  const isCurrent = m.getMonth() === today.getMonth() && m.getFullYear() === today.getFullYear();
  roadmapRows.push({
    label: monthLabel,
    target: 12,
    actual: monthPosts.length,
    cumulative,
    cumulativeTarget: (offset + 1) * 12,
    isPast,
    isCurrent,
  });
}
---

<Base title="Content Calendar | Admin" noindex={true}>
  <div class="admin-layout">
    <h1>Content Calendar</h1>
    <p class="admin-subtitle">Publishing schedule and content planning</p>

    <span id="api-status" class="api-status api-status--offline">Checking API...</span>

    <div class="admin-actions-bar">
      <button class="admin-btn" data-action="plan">Generate Content Plan</button>
    </div>
    <pre id="action-output"></pre>

    <nav class="admin-nav">
      <a href={`${base}/admin/`} class="admin-nav-link">Editorial</a>
      <a href={`${base}/admin/posts/`} class="admin-nav-link">All Posts</a>
      <a href={`${base}/admin/calendar/`} class="admin-nav-link active">Calendar</a>
      <a href={`${base}/admin/archive/`} class="admin-nav-link">Archive</a>
      <a href={`${base}/admin/seo/`} class="admin-nav-link">SEO</a>
      <a href={`${base}/admin/opportunities/`} class="admin-nav-link">Opportunities</a>
      <a href={`${base}/admin/distribution/`} class="admin-nav-link">Distribution</a>
      <a href={`${base}/admin/monetization/`} class="admin-nav-link">Monetization</a>
      <a href={`${base}/admin/performance/`} class="admin-nav-link">Performance</a>
    </nav>

    <!-- Publishing Stats -->
    <div class="admin-stats-grid">
      <div class="admin-stat">
        <span class="admin-stat-number">{thisMonth.length}</span>
        <span class="admin-stat-label">This Month</span>
      </div>
      <div class="admin-stat">
        <span class="admin-stat-number">{lastMonth.length}</span>
        <span class="admin-stat-label">Last Month</span>
      </div>
      <div class="admin-stat">
        <span class="admin-stat-number">{published.length}</span>
        <span class="admin-stat-label">Total Published</span>
      </div>
      <div class="admin-stat">
        <span class="admin-stat-number">{allPosts.filter(p => p.data.draft).length}</span>
        <span class="admin-stat-label">In Pipeline</span>
      </div>
    </div>

    <!-- Pillar Legend -->
    <div class="cal-legend">
      {Object.entries(pillarColors).map(([pillar, color]) => (
        <span class="cal-legend-item">
          <span class="cal-legend-dot" style={`background: ${color}`}></span>
          {pillar.charAt(0).toUpperCase() + pillar.slice(1)}
        </span>
      ))}
      <span class="cal-legend-item">
        <span class="cal-legend-dot" style="background: #bdbdbd"></span>
        Draft
      </span>
    </div>

    <!-- Calendar Grid -->
    {calMonths.map(({ label, cells }) => (
      <div class="admin-card cal-month">
        <h2>{label}</h2>
        <div class="cal-grid">
          <div class="cal-header">Sun</div>
          <div class="cal-header">Mon</div>
          <div class="cal-header">Tue</div>
          <div class="cal-header">Wed</div>
          <div class="cal-header">Thu</div>
          <div class="cal-header">Fri</div>
          <div class="cal-header">Sat</div>
          {cells.map(cell => {
            if (cell.day === null) return <div class="cal-cell cal-cell--empty"></div>;
            return (
              <div class={`cal-cell ${cell.isToday ? 'cal-cell--today' : ''} ${cell.posts.length > 0 ? 'cal-cell--has-posts' : ''}`}>
                <span class="cal-day-number">{cell.day}</span>
                {cell.posts.map(p => (
                  <a
                    href={`${base}/admin/post/${p.id}/`}
                    class={`cal-post ${p.data.draft ? 'cal-post--draft' : ''}`}
                    style={`border-left-color: ${p.data.draft ? '#bdbdbd' : (pillarColors[p.data.pillar] || '#999')}`}
                    title={`${p.data.title} (${p.data.pillar}, ${p.data.contentType || 'article'})`}
                  >
                    {p.data.title.length > 30 ? p.data.title.slice(0, 28) + '...' : p.data.title}
                  </a>
                ))}
              </div>
            );
          })}
        </div>
      </div>
    ))}

    <!-- Roadmap Targets -->
    <div class="admin-card">
      <h2>SEO Roadmap Targets</h2>
      <p class="admin-subtitle">Per the roadmap: 12 posts/month, 8 pins per post, targeting 50K sessions in 6 months.</p>
      <table class="admin-table">
        <thead>
          <tr>
            <th>Month</th>
            <th>Target Posts</th>
            <th>Actual</th>
            <th>Cumulative</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          {roadmapRows.map(row => (
            <tr class={row.isCurrent ? 'current-month-row' : ''}>
              <td><strong>{row.label}</strong>{row.isCurrent ? ' (current)' : ''}</td>
              <td>{row.target}</td>
              <td>{row.actual}</td>
              <td>{row.cumulative} / {row.cumulativeTarget}</td>
              <td>
                <span class={`status-badge ${row.actual >= row.target ? 'voice-score--good' : row.isCurrent ? 'voice-score--warn' : row.isPast ? 'voice-score--bad' : ''}`}>
                  {row.actual >= row.target ? 'On Track' : row.isCurrent ? 'In Progress' : row.isPast ? 'Behind' : 'Planned'}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
  <AdminActions />
</Base>

<style>
  .cal-legend {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
    font-size: 0.8rem;
    font-family: var(--font-ui);
  }
  .cal-legend-item {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }
  .cal-legend-dot {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    display: inline-block;
  }
  .cal-month {
    margin-bottom: 1.5rem;
  }
  .cal-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
  }
  .cal-header {
    background: var(--color-bg-alt, #f9f9f9);
    padding: 0.4rem;
    text-align: center;
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .cal-cell {
    background: var(--color-bg);
    min-height: 80px;
    padding: 0.3rem;
    position: relative;
  }
  .cal-cell--empty {
    background: var(--color-bg-alt, #f9f9f9);
    min-height: 80px;
  }
  .cal-cell--today {
    background: #fffde7;
  }
  .cal-day-number {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-light);
    display: block;
    margin-bottom: 0.2rem;
  }
  .cal-cell--today .cal-day-number {
    color: #1565c0;
    font-weight: 700;
  }
  .cal-post {
    display: block;
    font-size: 0.6rem;
    line-height: 1.3;
    padding: 0.15rem 0.3rem;
    margin-bottom: 0.15rem;
    border-left: 3px solid;
    background: #f5f5f5;
    text-decoration: none;
    color: var(--color-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cal-post:hover {
    background: #e0e0e0;
  }
  .cal-post--draft {
    opacity: 0.6;
    font-style: italic;
  }
  .current-month-row {
    background: #fffde7;
  }
  @media (max-width: 700px) {
    .cal-cell {
      min-height: 50px;
    }
    .cal-post {
      font-size: 0.55rem;
    }
  }
</style>
