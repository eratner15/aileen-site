---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import navigation from '../data/navigation.json';

// Dynamic popular links for footer
const popularPosts = (await getCollection('posts', ({ data }) => !data.draft && (data.featured || data.cornerstone)))
  .sort((a, b) => (a.data.featuredOrder || 99) - (b.data.featuredOrder || 99))
  .slice(0, 4);

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  noindex?: boolean;
  ogTitle?: string;
  ogDescription?: string;
  canonicalOverride?: string;
  isAdmin?: boolean;
}

const {
  title,
  description = 'Elegant travel, timeless style, and food that feels like home.',
  ogImage = '/og-image.jpg',
  canonicalURL = Astro.url.href,
  noindex = false,
  ogTitle,
  ogDescription,
  canonicalOverride,
  isAdmin = false,
} = Astro.props;

const siteTitle = title === 'AILEEN Magazine' ? title : `${title} | AILEEN Magazine`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const gaId = import.meta.env.PUBLIC_GA_ID || '';
const resolvedCanonical = canonicalOverride || canonicalURL;
const resolvedOgTitle = ogTitle || siteTitle;
const resolvedOgDescription = ogDescription || description;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{siteTitle}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={resolvedCanonical} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={resolvedOgTitle} />
  <meta property="og:description" content={resolvedOgDescription} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={resolvedCanonical} />
  <meta property="og:site_name" content="AILEEN Magazine" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={resolvedOgTitle} />
  <meta name="twitter:description" content={resolvedOgDescription} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Pinterest verification -->
  <meta name="p:domain_verify" content="" />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- RSS Autodiscovery -->
  <link rel="alternate" type="application/rss+xml" title="AILEEN Magazine" href={`${base}/rss.xml`} />

  <!-- Preconnect to Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <!-- GA4 -->
  {gaId && (
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
  )}
  {gaId && (
    <script define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', gaId);
    </script>
  )}

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "AILEEN Magazine",
    "url": "https://cafecito-ai.com/magazine",
    "description": "Elegant travel, timeless style, and food that feels like home.",
    "publisher": {
      "@type": "Organization",
      "name": "AILEEN Magazine",
      "url": "https://cafecito-ai.com/magazine",
      "logo": {
        "@type": "ImageObject",
        "url": "https://cafecito-ai.com/magazine/favicon.svg"
      }
    },
    "author": {
      "@type": "Person",
      "name": "Aileen Lavin"
    }
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "AILEEN Magazine",
    "url": "https://cafecito-ai.com/magazine",
    "logo": "https://cafecito-ai.com/magazine/favicon.svg",
    "sameAs": [
      "https://instagram.com/aileenlavin",
      "https://pinterest.com/aileenlavin",
      "https://tiktok.com/@aileenlavin"
    ],
    "founder": {
      "@type": "Person",
      "name": "Aileen Lavin"
    }
  })} />
</head>
<body class={isAdmin ? 'is-admin' : ''}>
  <header class="site-header">
    <div class="header-inner">
      <a href={`${base}/`} class="site-logo">
        AILEEN
        <span>Magazine</span>
      </a>
      <button class="nav-toggle" aria-label="Toggle navigation">
        <span></span><span></span><span></span>
      </button>
      <nav class="site-nav">
        <ul class="main-nav">
          {navigation.main.map(item => (
            <li><a href={`${base}${item.href}`}>{item.label}</a></li>
          ))}
        </ul>
        <div class="nav-secondary">
          {navigation.secondary.map(item => (
            <a href={`${base}${item.href}`} class="nav-secondary-link">{item.label}</a>
          ))}
        </div>
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  {!isAdmin && (
    <!-- Newsletter CTA -->
    <section class="newsletter-cta">
      <div class="newsletter-cta-inner">
        <p class="section-label" style="color: var(--color-text-muted);">The AILEEN Edit</p>
        <h2>A weekly letter on what's worth your time.</h2>
        <p>In travel, style, and everything in between. No fluff, no filler.</p>
        <form class="newsletter-form" data-newsletter="true">
          <input type="email" placeholder="Your email address" aria-label="Email address" required />
          <button type="submit">Subscribe</button>
        </form>
        <p class="newsletter-privacy">We respect your privacy. Unsubscribe anytime.</p>
      </div>
    </section>
  )}

  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-brand">
        <div class="site-logo">AILEEN<span>Magazine</span></div>
        <p>Elegant travel, timeless style, and food that feels like home.</p>
        <p class="footer-tagline">No fluff, no filler.</p>
      </div>
      <div class="footer-col">
        <h4>Explore</h4>
        <ul>
          {navigation.footer.explore.map(item => (
            <li><a href={`${base}${item.href}`}>{item.label}</a></li>
          ))}
        </ul>
      </div>
      <div class="footer-col">
        <h4>Popular</h4>
        <ul>
          {popularPosts.length > 0 ? (
            popularPosts.map(post => {
              const [pillar, ...rest] = post.id.split('/');
              return <li><a href={`${base}/${pillar}/${rest.join('/')}/`}>{post.data.title}</a></li>;
            })
          ) : (
            <>
              <li><a href={`${base}/travel/`}>Travel Guides</a></li>
              <li><a href={`${base}/style/`}>Style Guides</a></li>
              <li><a href={`${base}/recipes/`}>Recipes</a></li>
            </>
          )}
        </ul>
      </div>
      <div class="footer-col">
        <h4>Connect</h4>
        <ul>
          {navigation.footer.connect.map(item => (
            <li>
              <a href={item.external ? item.href : `${base}${item.href}`}
                {...(item.external ? { target: '_blank', rel: 'noopener' } : {})}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      &copy; {new Date().getFullYear()} AILEEN Magazine. All rights reserved.
    </div>
  </footer>

  <!-- Analytics event tracking -->
  <script>
    // Mobile nav toggle
    document.querySelector('.nav-toggle')?.addEventListener('click', () => {
      document.querySelector('.site-nav')?.classList.toggle('open');
      document.querySelector('.nav-toggle')?.classList.toggle('active');
    });

    // Sticky header shadow
    const header = document.querySelector('.site-header');
    window.addEventListener('scroll', () => {
      header?.classList.toggle('scrolled', window.scrollY > 20);
    });

    // Track outbound clicks (affiliate, booking, reservation)
    document.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest('a[data-affiliate], a[data-booking], a[data-reservation]');
      if (target && typeof window.gtag === 'function') {
        const type = target.hasAttribute('data-affiliate') ? 'affiliate' :
                     target.hasAttribute('data-booking') ? 'booking' : 'reservation';
        window.gtag('event', 'outbound_click', {
          event_category: type,
          event_label: (target as HTMLAnchorElement).href,
          transport_type: 'beacon',
        });
      }
    });

    // Track newsletter form submissions
    document.querySelectorAll('form[data-newsletter]').forEach(form => {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const email = (form.querySelector('input[type="email"]') as HTMLInputElement)?.value;
        if (email && typeof window.gtag === 'function') {
          window.gtag('event', 'newsletter_signup', {
            event_category: 'engagement',
            event_label: window.location.pathname,
          });
        }
        // TODO: Connect to email provider API
        const btn = form.querySelector('button');
        if (btn) {
          btn.textContent = 'Thank you!';
          btn.setAttribute('disabled', 'true');
        }
      });
    });

    // Scroll depth tracking (25%, 50%, 75%, 100%)
    const scrollMarks = [25, 50, 75, 100];
    const fired: Record<number, boolean> = {};
    window.addEventListener('scroll', () => {
      if (typeof window.gtag !== 'function') return;
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      if (docHeight <= 0) return;
      const pct = Math.round((scrollTop / docHeight) * 100);
      for (const mark of scrollMarks) {
        if (pct >= mark && !fired[mark]) {
          fired[mark] = true;
          window.gtag('event', 'scroll_depth', {
            event_category: 'engagement',
            event_label: `${mark}%`,
            value: mark,
          });
        }
      }
    });
  </script>
</body>
</html>
