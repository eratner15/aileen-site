---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  pillar: string;
  date: string;
  image: string;
  imageAlt: string;
  keyword: string;
}

const { title, description, pillar, date, image, imageAlt, keyword } = Astro.props;
---

<Base title={title} description={description}>

  <article>
    <header class="article-header">
      <span class="pillar-badge">{pillar}</span>
      <h1>{title}</h1>
      <p class="article-meta">By Aileen Lavin &middot; {date} &middot; AILEEN Magazine</p>
    </header>

    <div class="article-hero-image container">
      <img src={image} alt={imageAlt} loading="eager" />
    </div>

    <div class="article-body">
      <slot />
    </div>
  </article>

  <!-- Related Posts -->
  <section class="container" style="padding: 2rem 0 4rem;">
    <div class="section-header">
      <p class="section-label">Keep Reading</p>
      <h2>More from {pillar}</h2>
    </div>
  </section>

  <!-- JSON-LD for Blog Post -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": title,
    "description": description,
    "image": image,
    "datePublished": date,
    "dateModified": date,
    "author": {
      "@type": "Person",
      "name": "Aileen Lavin",
      "url": "https://aileenlavin.com/about/"
    },
    "publisher": {
      "@type": "Organization",
      "name": "AILEEN Magazine",
      "url": "https://aileenlavin.com"
    },
    "mainEntityOfPage": {
      "@type": "WebPage"
    }
  })} />

</Base>
